        const selectedEditionId = normalizeEditionId(book.editionKey || "");
        const editionUrl = book.editionUrl || (selectedEditionId
          ? `https://openlibrary.org/books/${selectedEditionId}`
          : "");
        const workId = String(book.workKey || book.key || "").match(/OL\d+W/i)?.[0];
        const openLibraryUrl = editionUrl || (workId
