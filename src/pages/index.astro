      function appendAuthorLinks(container: HTMLElement, authorValue: string) {
        const author = document.createElement("span");
        author.className = "author-text";
        if (!authorValue || authorValue.trim().toLowerCase() === "unknown author") {
          author.textContent = "Unknown Author";
          container.appendChild(author);
          return;
        }
        const authors = String(authorValue || "Unknown Author")
          .split(/\s*(?:,|&|\band\b)\s*/i)
          .map((name) => name.trim())
          .filter(Boolean);

        authors.forEach((name, index) => {
          if (index > 0) author.appendChild(document.createTextNode(", "));
          if (name.toLowerCase() === "unknown author") {
            author.appendChild(document.createTextNode("Unknown Author"));
            return;
          }
          const link = document.createElement("a");
          link.href = `?panel=search-db&query=${encodeURIComponent(name)}&author=1&author_exact=1`;
          link.className = "author-search-link";
          link.dataset.authorQuery = name;
          link.dataset.authorExact = "true";
          link.textContent = name;
          author.appendChild(link);
        });

        container.appendChild(author);
      }

      function renderLocalBook(book: any) {
        if (!book?.title || !isShelfStatus(book.status)) return;
        const shelf = shelfDefinitions.find((item) => item.status === book.status)!;
        const panel = document.getElementById(shelf.id);
        const grid = panel?.querySelector<HTMLElement>(".cards-grid");
        if (!grid) return;

        const card = document.createElement("article");
        card.className = "card local-book-card";
        card.dataset.localBookKey = String(getBookIdentity(book));
        card.dataset.bookKey = String(book.key || "");
        card.dataset.workKey = String(book.workKey || "");
        card.dataset.editionKey = String(book.editionKey || "");
        card.dataset.isbn = String(book.isbn || "");
        card.dataset.publisher = String(book.publisher || "");
        card.dataset.title = String(book.title).toLowerCase();
        card.dataset.subtitle = String(book.subtitle || "").toLowerCase();
        card.dataset.author = String(book.author || "").toLowerCase();
        card.dataset.year = String(parseInt(String(book.pubDate), 10) || 0);
        card.dataset.dateAdded = String(Number(book.dateAdded) || "");
        const cachedLanguage = editionLanguageCache[normalizeEditionId(book.editionKey)];
        const bookLanguage = [book.editionLanguage, book.language, cachedLanguage]
