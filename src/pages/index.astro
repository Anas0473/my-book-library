      function updateOpenLibrarySyncLabel() {
        const username = localStorage.getItem(openLibraryUsernameKey);
        openLibrarySyncButton.textContent = username
          ? "Open Library connected"
          : "Connect Open Library";
        openLibrarySyncButton.title = username ? "Sync Open Library" : "";
        openLibrarySyncButton.classList.toggle("is-connected", Boolean(username));
        mobileOpenLibrarySyncButton.classList.toggle("is-connected", Boolean(username));
        mobileOpenLibrarySyncButton.textContent = username ? "Sync" : "Connect";
        mobileOpenLibrarySyncButton.setAttribute(
          "aria-label",
          username ? "Sync Open Library" : "Connect Open Library",
        );
        openLibrarySyncStatus.hidden = true;
