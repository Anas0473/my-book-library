        removeOption.setAttribute("role", "menuitem");
        removeOption.dataset.action = "remove";
        removeOption.textContent = "Delete from My Lists";
        removeOption.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("library:book-removed", { detail: book }));
