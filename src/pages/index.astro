              count.textContent = String((serverShelfCounts.get(id) || 0) + localCount);
            });

          const panel = document.getElementById(id);
          const emptyMessage = panel?.querySelector<HTMLElement>(".empty-msg:not(.no-match-msg)");
          if (emptyMessage) {
            emptyMessage.style.display = (serverShelfCounts.get(id) || 0) + localCount > 0
              ? "none"
              : "";
