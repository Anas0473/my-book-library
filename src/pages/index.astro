      function updateShelfCounts() {
        shelfDefinitions.forEach(({ id, status }) => {
          const localCount = localBooks.filter((book) => book.status === status).length;
          document
            .querySelectorAll<HTMLElement>(`[data-target="${id}"] .category-count`)
