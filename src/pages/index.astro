      function openCoverLightbox(cover: HTMLImageElement) {
        const largeSrc = cover.src
          .replace(/-M\.jpg(?=\?|$)/, "-L.jpg")
          .replace(
            /^https:\/\/archive\.org\/services\/img\/([^/?#]+)$/,
            "https://archive.org/download/$1/page/cover_w800.jpg",
          );
        coverLightboxImage.onerror = null;
        coverLightboxImage.src = cover.src;
        coverLightboxImage.alt = cover.alt;
        coverLightbox.showModal();

        const requestId = ++coverLightboxRequest;
        if (largeSrc === cover.src) return;
        const largeImage = new Image();
        largeImage.referrerPolicy = "no-referrer";
        largeImage.onload = () => {
          if (requestId === coverLightboxRequest) coverLightboxImage.src = largeSrc;
        };
        largeImage.src = largeSrc;
