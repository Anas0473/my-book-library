        if (openLibraryUrl) {
          const editionLink = document.createElement("p");
          editionLink.className = "edition-link-text";
          const link = document.createElement("a");
          link.href = openLibraryUrl;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.textContent = "Open selected edition";
          editionLink.appendChild(link);
          details.appendChild(editionLink);
        }
        const editionButton = document.createElement("button");
        editionButton.type = "button";
        editionButton.className = "edition-button category-edition-button";
        editionButton.dataset.title = book.title;
        editionButton.dataset.author = book.author || "";
        editionButton.dataset.work = book.workKey || "";
        editionButton.dataset.editionKey = book.editionKey || "";
        editionButton.dataset.editionCount = String(Number(book.editionCount) || 0);
        editionButton.dataset.editionLanguage = book.editionLanguage || "";
        editionButton.dataset.status = book.status || "";
        editionButton.dataset.heroImage = book.heroImage || "";
        editionButton.textContent = `Browse editions${book.editionCount ? ` (${book.editionCount})` : ""}`;
        details.appendChild(editionButton);
        if (book.openLibraryRemoved) {
          const removedNotice = document.createElement("span");
          removedNotice.className = "open-library-removed";
          removedNotice.textContent = "No longer on Open Library";
