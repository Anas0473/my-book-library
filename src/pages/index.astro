        selectionLabel.append(checkbox, document.createTextNode("Select book"));
        card.appendChild(selectionLabel);

        const details = document.createElement("div");
        const fallbackImage = book.heroImage;
        const selectedEditionImage = book.editionHeroImage;
        if (selectedEditionImage || fallbackImage) {
          const image = document.createElement("img");
