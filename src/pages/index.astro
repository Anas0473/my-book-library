      async function syncOpenLibrary(username: string) {
        const previousUsername = localStorage.getItem(openLibraryUsernameKey);
        if (
          previousUsername &&
          previousUsername !== username &&
          !window.confirm(`Switch from ${previousUsername} to ${username}? Books synced from ${previousUsername} will be replaced. Books added only in this app will stay.`)
        ) {
          openLibrarySyncMessage.textContent = "Account switch cancelled.";
          return;
        }

        openLibrarySyncButton.disabled = true;
        mobileOpenLibrarySyncButton.disabled = true;
        openLibrarySyncSubmit.disabled = true;
        openLibrarySyncMessage.textContent = "Syncing your public reading log…";
        openLibrarySyncStatus.hidden = false;
        openLibrarySyncStatus.textContent = "Syncing Open Library…";

        try {
          const response = await fetch(
            `/api/openlibrary-reading-log.json?username=${encodeURIComponent(username)}`,
          );
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "Could not sync Open Library.");

          const syncedBooks = Array.isArray(data.books) ? data.books : [];
          const incompleteShelves = Array.isArray(data.incompleteShelves)
            ? data.incompleteShelves
            : [];
          const incompleteStatuses = new Set(
            incompleteShelves.map((shelf: any) => shelf.status),
          );
          const previousSyncedBooks = localBooks.filter(
            (book) => book.openLibrarySyncUsername === username,
          );

          function matchesSyncedBook(existingBook: any, syncedBook: any) {
            if (existingBook.editionKey && syncedBook.editionKey) {
              return existingBook.editionKey === syncedBook.editionKey;
            }
            if (existingBook.openLibrarySyncUsername || syncedBook.openLibrarySyncUsername) {
              const existingWorkKey = existingBook.workKey || existingBook.key;
              const syncedWorkKey = syncedBook.workKey || syncedBook.key;
              if (existingWorkKey && syncedWorkKey) return existingWorkKey === syncedWorkKey;
            }
            return isSameBook(existingBook, syncedBook);
          }

          const nextBooks = localBooks.flatMap((book) => {
            if (!book.openLibrarySyncUsername) return [book];
            if (book.openLibrarySyncUsername !== username) return [];
            if (incompleteStatuses.has(book.status)) return [book];

            const isStillOnOpenLibrary = syncedBooks.some((syncedBook: any) =>
              matchesSyncedBook(book, syncedBook),
            );
            return isStillOnOpenLibrary
              ? []
              : [{ ...book, openLibraryRemoved: true }];
          });

          syncedBooks.forEach((book: any) => {
            const previousSyncedBook = previousSyncedBooks.find((savedBook) =>
              matchesSyncedBook(savedBook, { ...book, openLibrarySyncUsername: username }),
            );
            const syncedBook = {
              ...previousSyncedBook,
              ...book,
              isbn: book.isbn || previousSyncedBook?.isbn || null,
              publisher: book.publisher || previousSyncedBook?.publisher || null,
              dateAdded: book.dateAdded || previousSyncedBook?.dateAdded || Date.now(),
              openLibrarySyncUsername: username,
              openLibraryRemoved: false,
            };
            const existingIndex = nextBooks.findIndex((savedBook) =>
              matchesSyncedBook(savedBook, syncedBook),
            );

            if (existingIndex >= 0) {
              nextBooks[existingIndex] = {
                ...nextBooks[existingIndex],
                ...syncedBook,
              };
            } else {
              nextBooks.push(syncedBook);
            }
          });

          localBooks = nextBooks;
          localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
          localStorage.setItem(openLibraryUsernameKey, username);
          localStorage.setItem(openLibraryLastSyncKey, String(Date.now()));
          const incompleteMessage = incompleteShelves
            .map((shelf: any) => `Open Library stopped paging the ${shelf.status} shelf; older synced books were kept`)
            .join(". ");
          const archivedCount = nextBooks.filter(
            (book) => book.openLibrarySyncUsername === username && book.openLibraryRemoved,
          ).length;
          const syncWarnings = [
            archivedCount > 0
              ? `${archivedCount} books no longer on Open Library were kept here`
              : "",
            incompleteMessage,
          ].filter(Boolean).join(". ");
          const syncResult = syncWarnings
            ? `Synced ${syncedBooks.length} books from ${username}. ${syncWarnings}.`
            : `Synced ${syncedBooks.length} books from ${username}.`;
          localStorage.setItem(openLibraryLastSyncResultKey, syncWarnings);
          openLibrarySyncStatus.textContent = syncResult;
          openLibrarySyncMessage.textContent = syncWarnings
            ? syncResult
            : `Synced ${syncedBooks.length} books.`;
          updateOpenLibrarySyncLabel();
          openLibrarySyncStatus.textContent = syncResult;
          window.setTimeout(() => {
            openLibrarySyncDialog.close();
            window.location.reload();
          }, 900);
        } catch (error) {
          const message = error instanceof Error ? error.message : "Could not sync Open Library.";
          openLibrarySyncMessage.textContent = message;
          openLibrarySyncStatus.textContent = message;
        } finally {
          openLibrarySyncButton.disabled = false;
          mobileOpenLibrarySyncButton.disabled = false;
          openLibrarySyncSubmit.disabled = false;
        }
      }

      function openOpenLibrarySyncDialog() {
        const username = localStorage.getItem(openLibraryUsernameKey) || "";
        openLibraryUsernameInput.value = username;
        updateOpenLibrarySyncSubmitLabel();
        openLibrarySyncMessage.textContent = "";
        openLibrarySyncDialog.showModal();
        openLibraryUsernameInput.focus();
      }

      function updateOpenLibrarySyncSubmitLabel() {
        const connectedUsername = localStorage.getItem(openLibraryUsernameKey);
        const enteredUsername = openLibraryUsernameInput.value.trim();
        openLibrarySyncSubmit.textContent = connectedUsername && enteredUsername !== connectedUsername
          ? "Switch and sync"
          : connectedUsername
            ? "Sync now"
            : "Connect and sync";
      }

