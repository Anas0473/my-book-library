      async function openCategoryEditions(button: HTMLButtonElement) {
        const work = button.dataset.work || "";
        const title = button.dataset.title || "";
        const author = button.dataset.author || "";
        const params = new URLSearchParams();
        if (work) params.set("work", work);
        else {
          params.set("title", title);
          if (author) params.set("author", author);
        }
        const preferredEdition = button.dataset.editionKey || "";
        const language = button.dataset.editionLanguage || "";
        if (preferredEdition) params.set("preferred_edition", preferredEdition);
        if (language) params.set("language", language);

        const requestId = ++editionRequestId;
        button.disabled = true;
        try {
          const response = await fetch(`/api/book-editions.json?${params}`);
          const data = await response.json();
          if (data.searchUnavailable) {
            showCategoryEditionUnavailable(title);
            return;
          }
          const editions = Array.isArray(data.editions) ? data.editions : [];
          const editionCount = Number(data.totalCount) || editions.length || Number(button.dataset.editionCount) || 0;
          if (editionCount > 0) {
            button.dataset.editionCount = String(editionCount);
            button.textContent = `Browse editions (${editionCount})`;
          }

          if (requestId !== editionRequestId) return;

          categoryEditionDialog.innerHTML = "";
          const header = document.createElement("div");
          header.className = "edition-dialog-header";
          const heading = document.createElement("h3");
          heading.textContent = `Editions of ${title}`;
          const closeButton = document.createElement("button");
          closeButton.type = "button";
          closeButton.className = "edition-dialog-close";
          closeButton.textContent = "Close";
          closeButton.addEventListener("click", () => categoryEditionDialog.close());
          header.append(heading, closeButton);
          categoryEditionDialog.appendChild(header);

          const summary = document.createElement("p");
          summary.className = "edition-summary";
          const filterRow = document.createElement("div");
          filterRow.className = "edition-filter-row";
          const languageFilter = document.createElement("select");
          languageFilter.className = "edition-language-filter";
          languageFilter.setAttribute("aria-label", "Filter editions by language");
          const allLanguagesOption = document.createElement("option");
          allLanguagesOption.value = "";
          allLanguagesOption.textContent = "All languages";
          languageFilter.appendChild(allLanguagesOption);
          const editionLanguageNames = new Intl.DisplayNames(["en"], { type: "language", fallback: "none" });
          const normalizeEditionLanguage = (code: string) =>
            ["und", "unknown", "unknown language"].includes(code.trim().toLowerCase())
              ? "unknown"
              : code.trim().toLowerCase();
          const getEditionLanguageName = (code: string) => {
            if (code === "unknown") return "Unknown";
            try {
              return editionLanguageNames.of(code) || code.toUpperCase();
            } catch {
              return code.toUpperCase();
            }
          };
          const editionLanguages: string[] = [];
          editions.forEach((edition: any) => {
            const code = normalizeEditionLanguage(String(edition.language || ""));
            if (code && !editionLanguages.includes(code)) editionLanguages.push(code);
          });
          editionLanguages.sort((first, second) => {
              if (first === "unknown language") return 1;
              if (first === "unknown") return 1;
              if (second === "unknown") return -1;
              return getEditionLanguageName(first).localeCompare(getEditionLanguageName(second));
            });
          editionLanguages.forEach((code) => {
            const option = document.createElement("option");
            option.value = code;
            option.textContent = getEditionLanguageName(code);
            languageFilter.appendChild(option);
          });
          languageFilter.value = "";
          filterRow.append(summary, languageFilter);

          const list = document.createElement("div");
          list.className = "edition-list";
          const pageSize = 12;
          let currentEditionPage = 1;
          const pagination = document.createElement("div");
          pagination.className = "edition-pagination";
          pagination.hidden = true;
          const previousPageButton = document.createElement("button");
          previousPageButton.type = "button";
          previousPageButton.textContent = "Previous";
          previousPageButton.setAttribute("aria-label", "Previous editions page");
          const pageJump = document.createElement("form");
          pageJump.className = "edition-page-jump";
          const pageInputLabel = document.createElement("label");
          pageInputLabel.htmlFor = "shelf-edition-page-input";
          pageInputLabel.textContent = "Go to page";
          const pageInput = document.createElement("input");
          pageInput.id = "shelf-edition-page-input";
          pageInput.type = "number";
          pageInput.min = "1";
          pageInput.step = "1";
          pageInput.inputMode = "numeric";
          const pageCountLabel = document.createElement("span");
          const pageJumpButton = document.createElement("button");
          pageJumpButton.type = "submit";
          pageJumpButton.textContent = "Go";
          pageJumpButton.formNoValidate = true;
          pageJump.append(pageInputLabel, pageInput, pageCountLabel, pageJumpButton);
          const nextPageButton = document.createElement("button");
          nextPageButton.type = "button";
          nextPageButton.textContent = "Next";
          nextPageButton.setAttribute("aria-label", "Next editions page");
          pagination.append(previousPageButton, pageJump, nextPageButton);
          const preview = document.createElement("section");
          preview.className = "category-edition-preview";
          preview.hidden = true;
          let listScrollPosition = 0;

          const isEditionInLists = (editionKey: string) =>
            localBooks.some((book) => book.editionKey === editionKey) ||
            Array.from(document.querySelectorAll<HTMLElement>("[data-content-book][data-edition-key]"))
              .some((card) => card.dataset.editionKey === editionKey);

          const showEditionPreview = (edition: any) => {
            const backButton = document.createElement("button");
            backButton.type = "button";
            backButton.className = "category-edition-preview-back";
            backButton.textContent = "Back to editions";
            backButton.addEventListener("click", () => {
              backButton.replaceWith(heading);
              preview.hidden = true;
              filterRow.hidden = false;
              list.hidden = false;
              renderEditionOptions();
              list.scrollTop = listScrollPosition;
            });

            const body = document.createElement("div");
            body.className = "category-edition-preview-body";
            const coverUrl = String(edition.coverImage || "");
            if (coverUrl) {
              const cover = document.createElement("img");
              cover.className = "category-edition-preview-cover";
              cover.alt = `Cover of ${edition.title}`;
              cover.referrerPolicy = "no-referrer";
              const zoomButton = createCoverZoomButton(cover);
              let triedStandardCover = false;
              cover.onerror = () => {
                if (!triedStandardCover && cover.src !== coverUrl) {
                  triedStandardCover = true;
                  cover.src = coverUrl;
                  return;
                }
                const placeholder = document.createElement("div");
                placeholder.className = "category-edition-preview-cover category-book-detail-no-cover";
                placeholder.textContent = "No cover available";
                zoomButton.replaceWith(placeholder);
              };
              cover.src = coverUrl.replace(/-M\.jpg$/, "-L.jpg");
              body.appendChild(zoomButton);
            } else {
              const placeholder = document.createElement("div");
              placeholder.className = "category-edition-preview-cover category-book-detail-no-cover";
              placeholder.textContent = "No cover available";
              body.appendChild(placeholder);
            }

            const details = document.createElement("div");
            details.className = "category-edition-preview-details";
            const editionTitle = document.createElement("h4");
            editionTitle.textContent = edition.title;
            details.appendChild(editionTitle);
            if (edition.subtitle) {
              const subtitle = document.createElement("p");
              subtitle.className = "category-edition-preview-subtitle";
              subtitle.textContent = edition.subtitle;
              details.appendChild(subtitle);
            }

            const metadata = document.createElement("dl");
            metadata.className = "category-edition-preview-meta";
            const pubDate = Array.isArray(edition.pubDate)
              ? edition.pubDate.filter(Boolean).join(", ")
              : String(edition.pubDate || "Unknown");
            const metadataItems: Array<[string, string]> = [
              ["Language", getDetailLanguageName(String(edition.language || ""))],
              ["Published", pubDate],
              ["Publisher", String(edition.publisher || "Unknown")],
              ["ISBN", String(edition.isbn || "Not listed")],
              ["Digital copy", edition.hasDigitalCopy ? "Available" : "Not listed"],
            ];
            metadataItems.forEach(([label, value]) => {
              const item = document.createElement("div");
              const term = document.createElement("dt");
              term.textContent = label;
              const description = document.createElement("dd");
              description.textContent = value;
              item.append(term, description);
              metadata.appendChild(item);
            });
            details.appendChild(metadata);

            const openLink = document.createElement("a");
            const editionActions = document.createElement("div");
            editionActions.className = "category-edition-actions";
            openLink.className = "category-edition-open-link";
            openLink.href = edition.url;
            openLink.target = "_blank";
            openLink.rel = "noopener noreferrer";
            openLink.textContent = "Open in Open Library";
            editionActions.appendChild(openLink);

            const editionBook = {
              key: edition.key,
              workKey: work,
              editionKey: edition.key,
              editionUrl: edition.url,
              title: edition.title || title,
              subtitle: edition.subtitle || "",
              author,
              pubDate: Array.isArray(edition.pubDate)
                ? edition.pubDate.filter(Boolean).join(", ")
                : String(edition.pubDate || ""),
              publisher: edition.publisher || "",
              isbn: edition.isbn || "",
              editionLanguage: edition.language || "",
              editionHeroImage: edition.coverImage || "",
              heroImage: button.dataset.heroImage || edition.coverImage || "",
              editionCount,
            };
            const savedEdition = localBooks.find((book) =>
              normalizeEditionId(book.editionKey || "") === normalizeEditionId(edition.key),
            );
            const contentEdition = Array.from(document.querySelectorAll<HTMLElement>(
              "[data-content-book][data-edition-key]",
            )).find((card) =>
              normalizeEditionId(card.dataset.editionKey || "") === normalizeEditionId(edition.key),
            );
            let currentStatus = savedEdition?.status || contentEdition?.dataset.status || null;
            let hasLocalSavedEdition = Boolean(savedEdition);
            const shelfControl = document.createElement("div");
            shelfControl.className = `shelf-control${currentStatus ? " is-saved" : ""}`;
            const primaryButton = document.createElement("button");
            primaryButton.type = "button";
            primaryButton.className = "shelf-primary";
            const toggleButton = document.createElement("button");
            toggleButton.type = "button";
            toggleButton.className = "shelf-toggle";
            toggleButton.setAttribute("aria-label", "Choose a reading list");
            toggleButton.setAttribute("aria-haspopup", "menu");
            toggleButton.setAttribute("aria-expanded", "false");
            toggleButton.textContent = "▾";
            const shelfMenu = document.createElement("div");
            shelfMenu.className = "shelf-menu";
            shelfMenu.setAttribute("role", "menu");
            shelfMenu.hidden = true;
            const updateEditionShelfControl = (status: string | null) => {
              currentStatus = status;
              const shelf = shelfDefinitions.find((item) => item.status === status);
              primaryButton.textContent = `${status ? "✓ " : ""}${shelf?.label || "Plan to Read"}`;
              primaryButton.title = status ? "Remove from My Lists" : "Add to Plan to Read";
              shelfControl.classList.toggle("is-saved", Boolean(status));
              shelfMenu.querySelectorAll<HTMLButtonElement>("[data-status]").forEach((option) => {
                if (option.dataset.status === status) option.setAttribute("aria-current", "true");
                else option.removeAttribute("aria-current");
              });
            };
            const saveEditionToShelf = (status: string) => {
              if (!isShelfStatus(status)) return;
              window.dispatchEvent(new CustomEvent("library:book-shelf-changed", {
                detail: { ...editionBook, status, dateAdded: Date.now() },
              }));
              hasLocalSavedEdition = true;
              deleteButton.hidden = false;
              updateEditionShelfControl(status);
              shelfMenu.hidden = true;
              toggleButton.setAttribute("aria-expanded", "false");
            };
            shelfDefinitions.forEach((shelf) => {
              const option = document.createElement("button");
              option.type = "button";
              option.setAttribute("role", "menuitem");
              option.dataset.status = shelf.status;
              option.textContent = shelf.label;
              option.addEventListener("click", () => saveEditionToShelf(shelf.status));
              shelfMenu.appendChild(option);
            });
            const deleteButton = document.createElement("button");
            deleteButton.type = "button";
            deleteButton.className = "category-edition-delete";
            deleteButton.textContent = "Delete";
            deleteButton.setAttribute("aria-label", "Delete from My Lists");
            deleteButton.title = "Delete from My Lists";
            deleteButton.hidden = !hasLocalSavedEdition;
            const removeEditionFromShelf = () => {
              if (!hasLocalSavedEdition) return;
              window.dispatchEvent(new CustomEvent("library:book-removed", { detail: editionBook }));
              hasLocalSavedEdition = false;
              deleteButton.hidden = true;
              updateEditionShelfControl(contentEdition?.dataset.status || null);
              shelfMenu.hidden = true;
              toggleButton.setAttribute("aria-expanded", "false");
            };
            deleteButton.addEventListener("click", removeEditionFromShelf);
            shelfControl.addEventListener("library:shelf-sync", () => {
              const saved = localBooks.find((book) => isSameBook(book, editionBook));
              hasLocalSavedEdition = Boolean(saved);
              deleteButton.hidden = !hasLocalSavedEdition;
              updateEditionShelfControl(saved?.status || (contentEdition?.isConnected ? contentEdition.dataset.status : null) || null);
            });
            const toggleEditionShelfMenu = () => {
              const shouldOpen = shelfMenu.hidden;
              document.querySelectorAll<HTMLElement>(".shelf-menu").forEach((menu) => {
                menu.hidden = true;
              });
              document.querySelectorAll<HTMLButtonElement>(".shelf-toggle").forEach((toggle) => {
                toggle.setAttribute("aria-expanded", "false");
              });
              shelfMenu.hidden = !shouldOpen;
              toggleButton.setAttribute("aria-expanded", String(shouldOpen));
            };
            primaryButton.addEventListener("click", (event) => {
              if (!currentStatus) {
                saveEditionToShelf("Plan to Read");
                return;
              }
              event.stopPropagation();
              removeEditionFromShelf();
            });
            toggleButton.addEventListener("click", (event) => {
              event.stopPropagation();
              toggleEditionShelfMenu();
            });
            shelfControl.append(primaryButton, toggleButton, shelfMenu);
            updateEditionShelfControl(currentStatus);
            const shelfActions = document.createElement("div");
            shelfActions.className = "category-edition-shelf-actions";
            shelfActions.append(shelfControl, deleteButton);
            editionActions.appendChild(shelfActions);
            details.appendChild(editionActions);
            body.appendChild(details);

            heading.replaceWith(backButton);
            preview.replaceChildren(body);
            listScrollPosition = list.scrollTop;
            filterRow.hidden = true;
            list.hidden = true;
            pagination.hidden = true;
            preview.hidden = false;
          };

          const renderEditionOptions = () => {
            const filteredEditions = editions.filter((edition: any) =>
              !languageFilter.value || normalizeEditionLanguage(String(edition.language || "")) === languageFilter.value,
            );
            const pageCount = Math.max(1, Math.ceil(filteredEditions.length / pageSize));
            const visibleEditions = filteredEditions.slice(
              (currentEditionPage - 1) * pageSize,
              currentEditionPage * pageSize,
            );
            const languageName = languageFilter.value ? getEditionLanguageName(languageFilter.value) : "";
            const languageCountLabel = languageName === "Unknown"
              ? `${filteredEditions.length} editions with unknown language`
              : `${filteredEditions.length} ${languageName} editions`;
            summary.textContent = pageCount > 1
              ? `Showing ${(currentEditionPage - 1) * pageSize + 1}–${Math.min(currentEditionPage * pageSize, filteredEditions.length)} of ${languageFilter.value ? languageCountLabel : `${editionCount} editions`}.`
              : languageName
                ? languageName === "Unknown"
                  ? `${filteredEditions.length} editions with unknown language found.`
                  : `${filteredEditions.length} ${languageName} ${filteredEditions.length === 1 ? "edition" : "editions"} found.`
                : editions.length === 1
                  ? "1 edition found."
                  : `${editions.length} editions found.`;
            pagination.hidden = pageCount <= 1;
            previousPageButton.disabled = currentEditionPage <= 1;
            nextPageButton.disabled = currentEditionPage >= pageCount;
            pageInput.max = String(pageCount);
            pageInput.value = String(currentEditionPage);
            pageCountLabel.textContent = `of ${pageCount}`;
            list.innerHTML = "";

            if (visibleEditions.length === 0) {
              const empty = document.createElement("p");
              empty.textContent = "No editions found.";
              list.appendChild(empty);
              return;
            }

            visibleEditions.forEach((edition: any) => {
              const option = document.createElement("button");
              option.type = "button";
              option.className = "edition-option";
              const cover = edition.coverImage
                ? document.createElement("img")
                : document.createElement("div");
              if (edition.coverImage) {
                (cover as HTMLImageElement).alt = "";
                (cover as HTMLImageElement).addEventListener("error", () => {
                  const placeholder = document.createElement("div");
                  placeholder.className = "edition-option-no-cover";
                  placeholder.textContent = "No cover";
                  cover.replaceWith(placeholder);
                }, { once: true });
                (cover as HTMLImageElement).src = edition.coverImage;
              } else {
                cover.className = "edition-option-no-cover";
                cover.textContent = "No cover";
              }
              const details = document.createElement("span");
              const editionTitle = document.createElement("strong");
              editionTitle.textContent = edition.title;
              const metadata = document.createElement("span");
              metadata.textContent = [edition.language, edition.pubDate, edition.publisher]
                .filter(Boolean)
                .join(" · ");
              details.append(editionTitle, metadata);
              const saved = isEditionInLists(edition.key);
              const status = document.createElement("span");
              status.className = "edition-choice-label";
              status.textContent = saved ? "✓ Added" : "View details";
              option.append(cover, details, status);
              option.addEventListener("click", () => showEditionPreview(edition));
              list.appendChild(option);
            });
          };

          previousPageButton.addEventListener("click", () => {
            if (currentEditionPage <= 1) return;
            currentEditionPage--;
            renderEditionOptions();
            list.scrollTop = 0;
          });
          nextPageButton.addEventListener("click", () => {
            const filteredCount = editions.filter((edition: any) =>
              !languageFilter.value || normalizeEditionLanguage(String(edition.language || "")) === languageFilter.value,
            ).length;
            if (currentEditionPage >= Math.ceil(filteredCount / pageSize)) return;
            currentEditionPage++;
            renderEditionOptions();
            list.scrollTop = 0;
          });
          languageFilter.addEventListener("change", () => {
            currentEditionPage = 1;
            renderEditionOptions();
            list.scrollTop = 0;
          });
          pageJump.addEventListener("submit", (event) => {
            event.preventDefault();
            if (!pageInput.value.trim()) return;
            const requestedPage = Number(pageInput.value);
            const filteredCount = editions.filter((edition: any) =>
              !languageFilter.value || normalizeEditionLanguage(String(edition.language || "")) === languageFilter.value,
            ).length;
            const pageCount = Math.max(1, Math.ceil(filteredCount / pageSize));
            currentEditionPage = Math.max(1, Math.min(pageCount, Math.trunc(requestedPage)));
            renderEditionOptions();
            list.scrollTop = 0;
          });
          renderEditionOptions();

          categoryEditionDialog.appendChild(filterRow);
          categoryEditionDialog.appendChild(list);
          categoryEditionDialog.appendChild(preview);
          categoryEditionDialog.appendChild(pagination);
          categoryEditionDialog.showModal();
        } catch {
          showCategoryEditionUnavailable(title);
        } finally {
          button.disabled = false;
        }
      }

      document.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          ".category-edition-button",
        );
        if (!button) return;
        event.preventDefault();
        event.stopPropagation();
        openCategoryEditions(button);
      });

      function persistPanel(
        target: string,
        query?: string,
        authorOnly = false,
        authorKey = "",
        authorExact = false,
      ) {
        const params = new URLSearchParams(window.location.search);
        params.set("panel", target);
        if (query) {
          params.set("query", query);
        } else {
          params.delete("query");
        }
        if (authorOnly) {
          params.set("author", "1");
        } else {
          params.delete("author");
        }
        if (authorKey) {
          params.set("author_key", authorKey);
        } else {
          params.delete("author_key");
        }
        if (authorExact) {
          params.set("author_exact", "1");
        } else {
          params.delete("author_exact");
        }
        const urlQuery = params.toString();
        window.history.replaceState(
          null,
          "",
          `${window.location.pathname}${urlQuery ? `?${urlQuery}` : ""}`,
        );
      }

      const pageParams = new URLSearchParams(window.location.search);
      const initialPanel = pageParams.get("panel");
      if (initialPanel && document.getElementById(initialPanel)) {
        activatePanel(initialPanel);
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-target");

          if (target) {
            clearSearchInputs();
            activatePanel(target);
            persistPanel(target);
          }
        });
      });

      document.querySelectorAll<HTMLAnchorElement>("[data-book-link]").forEach(
        (link) => {
          link.addEventListener("click", () => {
            const activePanel = document.querySelector<HTMLElement>(
              ".category-panel.active",
            );
            const filterInput = activePanel?.querySelector<HTMLInputElement>(
              ".search-input",
            );
            const sortSelect = activePanel?.querySelector<HTMLSelectElement>(
              ".sort-select",
            );
            const detailParams = new URLSearchParams();

            if (activePanel?.id) {
              detailParams.set("returnPanel", activePanel.id);
            }
            if (filterInput?.value) {
              detailParams.set("returnFilter", filterInput.value);
            }
            if (sortSelect?.value && sortSelect.value !== "title-asc") {
              detailParams.set("returnSort", sortSelect.value);
            }
            detailParams.set("returnScroll", String(window.scrollY));

            link.href = `${link.href.split("?")[0]}?${detailParams}`;
          });
        },
      );

      panels.forEach((panel) => {
        const searchInput = panel.querySelector(
          ".search-input",
        ) as HTMLInputElement;
        const sortSelect = panel.querySelector(
          ".sort-select",
        ) as HTMLSelectElement;
        const languageSelect = panel.querySelector(
          ".language-select",
        ) as HTMLSelectElement;
        const resetFiltersButton = panel.querySelector(
          ".reset-filters-button",
        ) as HTMLButtonElement;
        const clearFilterButton = panel.querySelector<HTMLButtonElement>(".filter-clear-button");
        const grid = panel.querySelector(".cards-grid") as HTMLElement;
        const noMatchMsg = panel.querySelector(".no-match-msg") as HTMLElement;

        if (!searchInput || !sortSelect || !languageSelect || !grid) return;

        if (panel.id === pageParams.get("panel")) {
          searchInput.value = pageParams.get("filter") || "";
          sortSelect.value = pageParams.get("sort") || "date-added-desc";
        }

        function updatePanel() {
          const query = searchInput.value.trim().toLowerCase();
          const normalizedIsbnQuery = searchInput.value.trim()
            .replace(/^ISBN(?:-1[03])?\s*[:#]?\s*/i, "")
            .replace(/[\s-]/g, "")
            .toUpperCase();
          const queryTerms = query.split(/\s+/).filter(Boolean).map((term) =>
            term.normalize("NFKD").replace(/[\u0300-\u036f]/g, ""),
          );
          const isWithinOneEdit = (first: string, second: string) => {
            if (Math.abs(first.length - second.length) > 1) return false;
            let firstIndex = 0;
            let secondIndex = 0;
            let edits = 0;
            while (firstIndex < first.length && secondIndex < second.length) {
              if (first[firstIndex] === second[secondIndex]) {
                firstIndex++;
                secondIndex++;
                continue;
              }
              if (++edits > 1) return false;
              if (first.length === second.length) {
                firstIndex++;
                secondIndex++;
              } else if (first.length > second.length) {
                firstIndex++;
              } else {
                secondIndex++;
              }
            }
            return edits + (first.length - firstIndex) + (second.length - secondIndex) <= 1;
          };
          const sortVal = sortSelect.value;
          const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
          cards.forEach((card) => {
            if (isKnownEditionLanguage(card.dataset.language)) return;
            const cachedLanguage = editionLanguageCache[normalizeEditionId(card.dataset.editionKey || "")];
            card.dataset.language = isKnownEditionLanguage(cachedLanguage)
              ? cachedLanguage
              : cachedLanguage === "unknown" ? "unknown" : "";
          });
          const selectedLanguage = languageSelect.value;
          const languageCounts = new Map<string, number>();
          cards.forEach((card) => {
            const language = card.dataset.language
              || (normalizeEditionId(card.dataset.editionKey || "") ? "unverified" : "unknown");
            languageCounts.set(language, (languageCounts.get(language) || 0) + 1);
          });
          const languageNames: Record<string, string> = {
            cpf: "French-based Creole", mul: "Multiple languages", tib: "Tibetan", tlh: "Klingon",
            und: "Unknown language", zxx: "No linguistic content",
          };
          const intlLanguageNames = new Intl.DisplayNames(["en"], { type: "language", fallback: "none" });
          const getLanguageName = (code: string) => {
            if (languageNames[code]) return languageNames[code];
            try {
              return intlLanguageNames.of(code) || code.toUpperCase();
            } catch {
              return code.toUpperCase();
            }
          };
          const languages = [...languageCounts.keys()]
            .filter((language) => language !== "unknown" && language !== "unverified")
            .sort((a, b) => getLanguageName(a).localeCompare(getLanguageName(b)));
          languageSelect.innerHTML = `<option value="">All languages (${cards.length})</option>`;
          languages.forEach((code) => {
            const option = document.createElement("option");
            option.value = code;
            option.textContent = `${getLanguageName(code)} (${languageCounts.get(code)})`;
            languageSelect.appendChild(option);
          });
          const unknownCount = languageCounts.get("unknown") || 0;
          const unverifiedCount = languageCounts.get("unverified") || 0;
          if (unknownCount > 0) {
            const option = document.createElement("option");
            option.value = "unknown";
            option.textContent = `Unknown language (${unknownCount})`;
            languageSelect.appendChild(option);
          }
          if (unverifiedCount > 0) {
            const option = document.createElement("option");
            option.value = "unverified";
            option.textContent = `Unverified (${unverifiedCount})`;
            languageSelect.appendChild(option);
          }
          languageSelect.disabled = cards.length === 0;
          languageSelect.value = [
            ...languages,
            ...(unknownCount > 0 ? ["unknown"] : []),
            ...(unverifiedCount > 0 ? ["unverified"] : []),
          ].includes(selectedLanguage)
            ? selectedLanguage
            : "";
          resetFiltersButton.disabled = !query
            && sortVal === "date-added-desc"
            && !languageSelect.value;
          if (clearFilterButton) clearFilterButton.hidden = searchInput.value.length === 0;
          const language = languageSelect.value;

          let visibleCount = 0;

          cards.forEach((card) => {
            const title = card.dataset.title || "";
            const subtitle = card.dataset.subtitle || "";
            const author = card.dataset.author || "";
            const isbn = String(card.dataset.isbn || "").replace(/[\s-]/g, "").toUpperCase();
            const matchesIsbn = normalizedIsbnQuery.length >= 10 && isbn.includes(normalizedIsbnQuery);
            const searchableFields = [title, subtitle, author].map((field) =>
              field.normalize("NFKD").replace(/[\u0300-\u036f]/g, ""),
            );
            const matchesText = queryTerms.every((term) => searchableFields.some((field) => {
              if (field.includes(term)) return true;
              if (term.length < 6) return false;
              return field.split(/[^a-z0-9]+/).some((word) =>
                Math.abs(word.length - term.length) <= 1 && isWithinOneEdit(word, term),
              );
            }))
              || matchesIsbn;
            const matchesLanguage = !language
              || (language === "unknown"
                ? card.dataset.language === "unknown"
                  || (!card.dataset.language && !normalizeEditionId(card.dataset.editionKey || ""))
                : language === "unverified"
                  ? !card.dataset.language && Boolean(normalizeEditionId(card.dataset.editionKey || ""))
                : card.dataset.language === language);
            const matches = matchesText && matchesLanguage;

            if (matches) {
              card.style.display = "flex";
              visibleCount++;
            } else {
              card.style.display = "none";
            }
          });

          if (noMatchMsg) {
            noMatchMsg.style.display =
              visibleCount === 0 && cards.length > 0 ? "block" : "none";
          }

          cards.sort((a, b) => {
            const titleA = a.dataset.title || "";
            const titleB = b.dataset.title || "";
            const yearA = parseInt(a.dataset.year || "0", 10);
            const yearB = parseInt(b.dataset.year || "0", 10);
            const dateAddedA = Number(a.dataset.dateAdded) || 0;
            const dateAddedB = Number(b.dataset.dateAdded) || 0;

            if (sortVal === "date-added-desc" || sortVal === "date-added-asc") {
              if (!dateAddedA && dateAddedB) return 1;
              if (dateAddedA && !dateAddedB) return -1;
              if (dateAddedA !== dateAddedB) {
                return sortVal === "date-added-desc"
                  ? dateAddedB - dateAddedA
                  : dateAddedA - dateAddedB;
              }
            }

            if (sortVal === "title-asc") {
              const titleComparison = titleA.localeCompare(titleB, undefined, {
                numeric: true,
                sensitivity: "base",
              });
              const subtitleComparison = (a.dataset.subtitle || "").localeCompare(
                b.dataset.subtitle || "",
                undefined,
                { numeric: true, sensitivity: "base" },
              );
              return titleComparison || subtitleComparison;
            }
            if (sortVal === "title-desc") {
              const titleComparison = titleB.localeCompare(titleA, undefined, {
                numeric: true,
                sensitivity: "base",
              });
              const subtitleComparison = (b.dataset.subtitle || "").localeCompare(
                a.dataset.subtitle || "",
                undefined,
                { numeric: true, sensitivity: "base" },
              );
              return titleComparison || subtitleComparison;
            }
            if (sortVal === "year-desc") return yearB - yearA;
            if (sortVal === "year-asc") return yearA - yearB;
            return 0;
          });

          cards.forEach((card) => grid.appendChild(card));
        }

        async function loadMissingEditionLanguages() {
          if (languageLoadPromise) return languageLoadPromise;
          if (Date.now() - lastLanguageLoadAt < 30000) return;
          const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
          const editionIds = [...new Set(cards
            .map((card) => normalizeEditionId(card.dataset.editionKey || ""))
            .filter((editionId) => editionId && !editionLanguageCache[editionId]))];
          if (editionIds.length === 0) return;
          const batchSize = 40;
          lastLanguageLoadAt = Date.now();

          languageLoadPromise = (async () => {
            for (let offset = 0; offset < editionIds.length; offset += batchSize) {
              try {
                const response = await fetch("/api/edition-languages.json", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ editionKeys: editionIds.slice(offset, offset + batchSize) }),
                });
                if (!response.ok) continue;
                const data = await response.json();
                Object.assign(editionLanguageCache, data.languages || {});
                (data.resolved || []).forEach((editionId: string) => {
                  if (!editionLanguageCache[editionId]) editionLanguageCache[editionId] = "unknown";
                });
                localStorage.setItem(editionLanguageCacheKey, JSON.stringify(editionLanguageCache));
                cards.forEach((card) => {
                  const editionId = normalizeEditionId(card.dataset.editionKey || "");
                  if (editionId && editionLanguageCache[editionId]) {
                    card.dataset.language = editionLanguageCache[editionId];
                  }
                });
                let savedBooksChanged = false;
                localBooks.forEach((book) => {
                  const editionId = normalizeEditionId(book.editionKey || "");
                  if (editionId && editionLanguageCache[editionId] && !isKnownEditionLanguage(book.editionLanguage)) {
                    book.editionLanguage = editionLanguageCache[editionId];
                    savedBooksChanged = true;
                  }
                });
                if (savedBooksChanged) localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
                updatePanel();
              } catch {
                break;
              }
            }
          })();
          try {
            await languageLoadPromise;
          } finally {
            languageLoadPromise = null;
          }
        }

        searchInput.addEventListener("input", updatePanel);
        clearFilterButton?.addEventListener("click", () => {
          searchInput.value = "";
          updatePanel();
          searchInput.focus();
        });
        sortSelect.addEventListener("change", updatePanel);
        languageSelect.addEventListener("change", updatePanel);
        resetFiltersButton.addEventListener("click", () => {
          searchInput.value = "";
          sortSelect.value = "date-added-desc";
          languageSelect.value = "";
          updatePanel();
          searchInput.focus();
        });
        updatePanel();
        panelRefreshers.set(panel.id, updatePanel);
        panelLanguageLoaders.set(panel.id, () => { void loadMissingEditionLanguages(); });
        if (panel.classList.contains("active")) void loadMissingEditionLanguages();

        const batchControls = panel.querySelector<HTMLElement>(".batch-controls");
        if (!batchControls) return;

        const selectionToggle = batchControls.querySelector<HTMLButtonElement>(".selection-toggle")!;
        const batchActions = batchControls.querySelector<HTMLElement>(".batch-actions")!;
        const selectAll = batchControls.querySelector<HTMLInputElement>(".select-all-checkbox")!;
        const selectionCount = batchControls.querySelector<HTMLElement>(".selection-count")!;
        const destination = batchControls.querySelector<HTMLSelectElement>(".batch-destination")!;
        const moveButton = batchControls.querySelector<HTMLButtonElement>(".batch-move")!;
        const removeButton = batchControls.querySelector<HTMLButtonElement>(".batch-remove")!;

        function getSelectedBooks() {
          return Array.from(grid.querySelectorAll<HTMLInputElement>(".local-book-checkbox:checked"))
            .map((checkbox) => {
              const card = checkbox.closest<HTMLElement>(".local-book-card");
              return localBooks.find((book) => card && isSameBook(book, {
                key: card.dataset.bookKey,
                workKey: card.dataset.workKey,
                editionKey: card.dataset.editionKey,
                isbn: card.dataset.isbn,
                title: card.dataset.title,
                author: card.dataset.author,
              }));
            })
            .filter((book): book is any => Boolean(book));
        }

        function updateSelectionControls() {
          const visibleCheckboxes = Array.from(
            grid.querySelectorAll<HTMLInputElement>(".local-book-checkbox"),
          ).filter((checkbox) => checkbox.closest<HTMLElement>(".card")?.style.display !== "none");
          const selectedCount = getSelectedBooks().length;
          const selectedVisibleCount = visibleCheckboxes.filter((checkbox) => checkbox.checked).length;
          selectionCount.textContent = `${selectedCount} selected`;
          destination.disabled = selectedCount === 0;
          moveButton.disabled = selectedCount === 0;
          removeButton.disabled = selectedCount === 0;
          selectAll.checked = visibleCheckboxes.length > 0 && selectedVisibleCount === visibleCheckboxes.length;
          selectAll.indeterminate = selectedVisibleCount > 0 && selectedVisibleCount < visibleCheckboxes.length;
        }

        function setSelectionMode(enabled: boolean) {
          panel.classList.toggle("selection-mode", enabled);
          batchActions.hidden = !enabled;
          selectionToggle.textContent = enabled ? "Cancel" : "Select books";
          selectionToggle.setAttribute("aria-pressed", String(enabled));

          if (!enabled) {
            grid.querySelectorAll<HTMLInputElement>(".local-book-checkbox").forEach((checkbox) => {
              checkbox.checked = false;
            });
          }
          updateSelectionControls();
        }

        selectionToggle.addEventListener("click", () => {
          setSelectionMode(!panel.classList.contains("selection-mode"));
        });

        searchInput.addEventListener("input", updateSelectionControls);

        selectAll.addEventListener("change", () => {
          const visibleCheckboxes = Array.from(
            grid.querySelectorAll<HTMLInputElement>(".local-book-checkbox"),
          ).filter((checkbox) => checkbox.closest<HTMLElement>(".card")?.style.display !== "none");
          visibleCheckboxes.forEach((checkbox) => {
            checkbox.checked = selectAll.checked;
          });
          updateSelectionControls();
        });

        grid.addEventListener("change", (event) => {
          if ((event.target as HTMLElement).matches(".local-book-checkbox")) {
            updateSelectionControls();
          }
        });

        grid.addEventListener("click", (event) => {
          if (!panel.classList.contains("selection-mode")) return;
          const target = event.target as HTMLElement;
          if (target.closest("button, input, select, label, a, .shelf-control")) return;

          const card = target.closest<HTMLElement>(".local-book-card");
          const checkbox = card?.querySelector<HTMLInputElement>(".local-book-checkbox");
          if (!checkbox) return;

          checkbox.checked = !checkbox.checked;
          updateSelectionControls();
        });

        moveButton.addEventListener("click", () => {
          const selectedBooks = getSelectedBooks();
          if (selectedBooks.length === 0) return;

          const status = destination.value;
          const undoBatchId = `move-${Date.now()}-${Math.random().toString(36).slice(2)}`;
          setSelectionMode(false);
          selectedBooks.forEach((book) => {
            window.dispatchEvent(new CustomEvent("library:book-shelf-changed", {
              detail: {
                ...book,
                status,
                undoBatchId,
              },
            }));
          });
        });

        removeButton.addEventListener("click", () => {
          const selectedBooks = getSelectedBooks();
          if (selectedBooks.length === 0) return;
          if (selectedBooks.length > 1 && !window.confirm(`Delete ${selectedBooks.length} selected books from your reading lists?`)) return;

          const undoBatchId = `delete-${Date.now()}-${Math.random().toString(36).slice(2)}`;
          setSelectionMode(false);
          selectedBooks.forEach((book) => {
            window.dispatchEvent(new CustomEvent("library:book-removed", { detail: { ...book, undoBatchId } }));
          });
        });
      });

      type ShelfUndoAction = { book: any; previousBook: any; deletedIndex?: number };
      type ShelfUndoNotification = {
        batchId: string;
        actions: ShelfUndoAction[];
        toast: HTMLDivElement;
        timer: number;
      };
      const shelfUndoNotifications: ShelfUndoNotification[] = [];
      const shelfUndoStack = document.createElement("div");
      shelfUndoStack.className = "shelf-undo-stack";
      document.body.appendChild(shelfUndoStack);
      document.addEventListener("close", () => {
        if (!shelfUndoStack.closest("dialog[open]")) document.body.appendChild(shelfUndoStack);
      }, true);

      function syncShelfControls() {
        document.querySelectorAll<HTMLElement>(".shelf-control").forEach((control) => {
          control.dispatchEvent(new Event("library:shelf-sync"));
        });
      }

      function dismissShelfUndoToast(notification: ShelfUndoNotification) {
        window.clearTimeout(notification.timer);
        notification.toast.remove();
        const index = shelfUndoNotifications.indexOf(notification);
        if (index >= 0) shelfUndoNotifications.splice(index, 1);
      }

      function invalidateShelfUndo(book: any) {
        [...shelfUndoNotifications].forEach((notification) => {
          if (notification.actions.some((action) => isSameBook(action.book, book))) {
            dismissShelfUndoToast(notification);
          }
        });
      }

      function showShelfUndoToast(book: any, previousBook: any, batchId = "", deletedIndex?: number) {
        let notification = batchId
          ? shelfUndoNotifications.find((item) => item.batchId === batchId)
          : undefined;
        if (!notification) {
          const toast = document.createElement("div");
          toast.className = "shelf-undo-toast";
          toast.setAttribute("role", "status");
          toast.setAttribute("aria-live", "polite");
          notification = { batchId, actions: [], toast, timer: 0 };
          shelfUndoNotifications.push(notification);
          shelfUndoStack.appendChild(toast);
          if (shelfUndoNotifications.length > 2) dismissShelfUndoToast(shelfUndoNotifications[0]);
        }
        const currentNotification = notification;
        const { toast, actions } = currentNotification;
        actions.push({ book, previousBook, deletedIndex });
        const openDialog = document.querySelector<HTMLDialogElement>("dialog[open]");
        (openDialog || document.body).appendChild(shelfUndoStack);

        const targetShelf = shelfDefinitions.find((shelf) => shelf.status === book.status);
        const isDelete = deletedIndex !== undefined;
        const message = document.createElement("span");
        const notificationBook = isDelete ? previousBook : book;
        const subtitle = String(notificationBook.subtitle || "").trim();
        const displayTitle = subtitle
          ? `${notificationBook.title}: ${subtitle}`
          : notificationBook.title;
        if (isDelete) {
          message.textContent = actions.length > 1
            ? `${actions.length} books deleted.`
            : `Deleted "${displayTitle}".`;
        } else {
          message.textContent = actions.length > 1
            ? `${actions.length} books moved to ${targetShelf?.label || book.status}.`
            : `Moved "${displayTitle}" to ${targetShelf?.label || book.status}.`;
        }
        const undoButton = document.createElement("button");
        undoButton.type = "button";
        undoButton.textContent = "Undo";
        undoButton.addEventListener("click", () => {
          let restoredCount = 0;
          // Restore deletions last-first so each saved index refers to the list as it was then.
          [...actions].reverse().forEach(({ book: movedBook, previousBook: oldBook, deletedIndex: oldIndex }) => {
            if (oldIndex !== undefined) {
              if (localBooks.some((item) => isSameBook(item, oldBook))) return;
              localBooks.splice(Math.min(oldIndex, localBooks.length), 0, oldBook);
              removeMatchingContentBooks(oldBook);
              renderLocalBook(oldBook);
              restoredCount++;
              return;
            }
            const existingIndex = localBooks.findIndex((item) => isSameBook(item, movedBook));
            if (existingIndex < 0 || localBooks[existingIndex].status !== movedBook.status) return;

            const restoredBook = { ...localBooks[existingIndex], ...oldBook };
            localBooks[existingIndex] = restoredBook;
            document.querySelectorAll<HTMLElement>("[data-local-book-key]").forEach((card) => {
              const cardBook = {
                key: card.dataset.bookKey,
                workKey: card.dataset.workKey,
                editionKey: card.dataset.editionKey,
                isbn: card.dataset.isbn,
                title: card.dataset.title,
                author: card.dataset.author,
              };
              if (isSameBook(restoredBook, cardBook)) card.remove();
            });
            renderLocalBook(restoredBook);
            restoredCount++;
          });

          if (restoredCount > 0) {
            localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
            updateShelfCounts();
            panelRefreshers.forEach((refreshPanel) => refreshPanel());
            syncShelfControls();
          }
          dismissShelfUndoToast(currentNotification);
        });
        toast.replaceChildren(message, undoButton);
        window.clearTimeout(currentNotification.timer);
        currentNotification.timer = window.setTimeout(() => dismissShelfUndoToast(currentNotification), 6000);
      }

      window.addEventListener("library:book-shelf-changed", (event) => {
        const detail = (event as CustomEvent).detail;
        if (!detail?.title || !isShelfStatus(detail.status)) return;
        const { undoBatchId = "", ...book } = detail;
        invalidateShelfUndo(book);

        const existingIndex = localBooks.findIndex((item) => isSameBook(item, book));
        const previousBook = existingIndex >= 0 ? localBooks[existingIndex] : null;
        const updatedBook = {
          ...(previousBook || {}),
          ...book,
          dateAdded: (previousBook?.dateAdded || null)
            || book.dateAdded
            || Date.now(),
        };

        if (existingIndex >= 0) {
          localBooks[existingIndex] = updatedBook;
        } else {
          localBooks.push(updatedBook);
        }

        localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
        removeMatchingContentBooks(updatedBook);
        document.querySelectorAll<HTMLElement>("[data-local-book-key]").forEach((card) => {
          const cardBook = {
            key: card.dataset.bookKey,
            workKey: card.dataset.workKey,
            editionKey: card.dataset.editionKey,
            isbn: card.dataset.isbn,
            title: card.dataset.title,
            author: card.dataset.author,
          };
          if (isSameBook(updatedBook, cardBook)) card.remove();
        });
        renderLocalBook(updatedBook);
        updateShelfCounts();
        panelRefreshers.forEach((refreshPanel) => refreshPanel());
        syncShelfControls();
        if (previousBook && previousBook.status !== updatedBook.status) {
          showShelfUndoToast(updatedBook, previousBook, undoBatchId);
        }
      });

      window.addEventListener("library:book-removed", (event) => {
        const { undoBatchId = "", ...book } = (event as CustomEvent).detail;
        const existingIndex = localBooks.findIndex((item) => isSameBook(item, book));
        if (existingIndex < 0) return;
        invalidateShelfUndo(book);

        const [deletedBook] = localBooks.splice(existingIndex, 1);
        localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
        document.querySelectorAll<HTMLElement>("[data-local-book-key]").forEach((card) => {
          const cardBook = {
            key: card.dataset.bookKey,
            workKey: card.dataset.workKey,
            editionKey: card.dataset.editionKey,
            isbn: card.dataset.isbn,
            title: card.dataset.title,
            author: card.dataset.author,
          };
          if (isSameBook(book, cardBook)) card.remove();
        });
        updateShelfCounts();
        panelRefreshers.forEach((refreshPanel) => refreshPanel());
        syncShelfControls();
        showShelfUndoToast(deletedBook, deletedBook, undoBatchId, existingIndex);
      });

      document.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest(".shelf-control")) return;
        document.querySelectorAll<HTMLElement>(".shelf-menu").forEach((menu) => {
          menu.hidden = true;
        });
        document.querySelectorAll<HTMLButtonElement>(".shelf-toggle").forEach((toggle) => {
          toggle.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (coverLightbox.open) {
          event.preventDefault();
          coverLightbox.close();
          return;
        }
        if (savedBookDetailDialog.open) {
          savedBookDetailDialog.close();
          return;
        }
        document.querySelectorAll<HTMLElement>(".category-panel.selection-mode").forEach((panel) => {
          panel.querySelector<HTMLButtonElement>(".selection-toggle")?.click();
        });
        document.querySelectorAll<HTMLElement>(".shelf-menu").forEach((menu) => {
          menu.hidden = true;
        });
        document.querySelectorAll<HTMLButtonElement>(".shelf-toggle").forEach((toggle) => {
          toggle.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Delete" && event.key !== "Del" && event.code !== "Delete") return;

        const target = event.target as HTMLElement;
        if (target.closest("input:not([type='checkbox']):not([type='radio']), textarea, select, [contenteditable='true']")) return;

        const activePanel = document.querySelector<HTMLElement>(
          ".category-panel.active.selection-mode",
        );
        const deleteButton = activePanel?.querySelector<HTMLButtonElement>(".batch-remove");
        if (!deleteButton || deleteButton.disabled) return;

        event.preventDefault();
        deleteButton.click();
      });

      const returnScroll = Number.parseInt(pageParams.get("scroll") || "", 10);
      if (Number.isFinite(returnScroll)) {
        requestAnimationFrame(() => window.scrollTo(0, returnScroll));
      }
    </script>
  </body>
</html>
