---
import { getCollection } from "astro:content";
import BookSearch from "../components/BookSearch.astro";

const allBooks = await getCollection("blog");

const naturalSort = (a: any, b: any) =>
  a.data.title.localeCompare(b.data.title, undefined, {
    numeric: true,
    sensitivity: "base",
  }) || String(a.data.subtitle || "").localeCompare(String(b.data.subtitle || ""), undefined, {
    numeric: true,
    sensitivity: "base",
  });

const reading = allBooks
  .filter((b) => b.data.status === "Reading")
  .sort(naturalSort);
const planToRead = allBooks
  .filter((b) => b.data.status === "Plan to Read")
  .sort(naturalSort);
const read = allBooks.filter((b) => b.data.status === "Read").sort(naturalSort);

const splitAuthors = (author: string) =>
  author
    .split(/\s*(?:,|&|\band\b)\s*/i)
    .map((name) => name.trim())
    .filter(Boolean);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Reading List</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <style>
      :global(:root) {
        --accent: #f3b94d;
        --accent-strong: #e6a836;
        --accent-ink: #1c1a16;
        --ok: #3fb950;
        --danger: #f2716b;
        --surface-dark: #232323;
        --surface-dark-2: #2c2c2c;
        --border-dark: #3a3a3a;
        --text-dark: #ececec;
        --text-dark-muted: #a8a39a;
        --font-sans: "Geist", system-ui, -apple-system, sans-serif;
        --font-serif: "Instrument Serif", Georgia, serif;
      }
      /* Page-level tones derive from the chosen background's foreground, so any custom background still works. */
      body {
        --fg: var(--page-foreground, #ececec);
        --muted: color-mix(in srgb, var(--fg) 64%, transparent);
        --faint: color-mix(in srgb, var(--fg) 44%, transparent);
        --line: color-mix(in srgb, var(--fg) 13%, transparent);
        --fill: color-mix(in srgb, var(--fg) 5%, transparent);
        --fill-strong: color-mix(in srgb, var(--fg) 10%, transparent);
        margin: 0;
        background: #1c1c1c;
        color: var(--fg);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
      }
      .container {
        display: grid;
        grid-template-columns: 228px minmax(0, 1fr);
        min-height: 100vh;
      }
      sidebar {
        position: sticky;
        top: 0;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        height: 100vh;
        box-sizing: border-box;
        padding: 1.5rem 1rem 1rem;
        border-right: 1px solid var(--line);
        background: color-mix(in srgb, var(--fg) 2%, transparent);
      }
      header h1 {
        margin: 0;
        padding: 0 0.6rem;
        font-family: var(--font-serif);
        font-size: 1.95rem;
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.01em;
      }
      .title-accent {
        color: var(--accent);
        font-style: italic;
      }
      .home-link {
        color: inherit;
        text-decoration: none;
      }
      .home-link:hover {
        opacity: 0.85;
      }
      .sidebar-section {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      sidebar h3 {
        margin: 0 0 0.45rem;
        padding: 0 0.6rem;
        color: var(--faint);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .category-btn {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 2.25rem;
        box-sizing: border-box;
        padding: 0.45rem 0.6rem;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.88rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
      }
      .category-btn:hover {
        background: var(--fill);
        color: var(--fg);
      }
      .category-btn.active {
        background: var(--fill-strong);
        color: var(--fg);
      }
      .category-btn.active::after {
        content: "";
        position: absolute;
        top: 0.5rem;
        bottom: 0.5rem;
        left: -1rem;
        width: 3px;
        border-radius: 0 3px 3px 0;
        background: var(--accent);
      }
      .category-btn svg {
        flex: 0 0 auto;
        width: 0.95rem;
        height: 0.95rem;
      }
      .category-count {
        min-width: 1.4rem;
        box-sizing: border-box;
        margin-left: auto;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        background: var(--fill-strong);
        color: var(--muted);
        font-size: 0.7rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        line-height: 1.35;
        text-align: center;
      }
      .open-library-button::before {
        content: "";
        flex: 0 0 auto;
        width: 0.5rem;
        height: 0.5rem;
        margin: 0 0.22rem;
        border-radius: 50%;
        background: var(--faint);
      }
      .open-library-button {
        font-size: 0.78rem;
        white-space: nowrap;
      }
      .open-library-button.is-connected::before {
        background: var(--ok);
        box-shadow:
          0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent),
          0 0 8px var(--ok);
      }
      .open-library-button:disabled {
        cursor: progress;
        opacity: 0.7;
      }
      .open-library-sync-status {
        display: block;
        box-sizing: border-box;
        margin: 0.1rem 0 0;
        padding: 0 0.6rem 0 1.95rem;
        color: var(--faint);
        font-size: 0.72rem;
        line-height: 1.4;
      }
      .open-library-sync-status[hidden] {
        display: none;
      }
      .theme-picker {
        position: relative;
        margin-top: auto;
      }
      .appearance-toggle {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        box-sizing: border-box;
        padding: 0.55rem 0.65rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--fill);
        color: var(--fg);
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
      }
      .appearance-toggle:hover,
      .appearance-toggle[aria-expanded="true"] {
        background: var(--fill-strong);
      }
      .appearance-swatch {
        flex: 0 0 auto;
        width: 1rem;
        height: 1rem;
        box-sizing: border-box;
        border: 1.5px solid var(--muted);
        border-radius: 50%;
        background: var(--page-background, #1c1c1c);
      }
      .appearance-value {
        margin-left: auto;
        color: var(--faint);
        font-size: 0.7rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .appearance-panel {
        position: absolute;
        right: 0;
        bottom: calc(100% + 0.5rem);
        left: 0;
        z-index: 40;
        padding: 0.85rem;
        border: 1px solid var(--border-dark);
        border-radius: 12px;
        background: var(--surface-dark);
        color: var(--text-dark);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
      }
      .appearance-panel[hidden] {
        display: none;
      }
      .appearance-panel h3 {
        margin: 0 0 0.6rem;
        padding: 0;
        color: var(--text-dark-muted);
      }
      .theme-custom-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .theme-color-input {
        width: 2.25rem;
        height: 2.25rem;
        flex: 0 0 2.25rem;
        padding: 2px;
        border: 1px solid var(--border-dark);
        border-radius: 8px;
        background: var(--surface-dark-2);
        cursor: pointer;
      }
      .theme-color-input::-webkit-color-swatch-wrapper {
        padding: 1px;
      }
      .theme-color-input::-webkit-color-swatch {
        border: 0;
        border-radius: 5px;
      }
      .theme-rgb-input {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        height: 2.25rem;
        padding: 0.35rem 0.55rem;
        border: 1px solid var(--border-dark);
        border-radius: 8px;
        background: var(--surface-dark-2);
        color: var(--text-dark);
        font: inherit;
        font-size: 0.8rem;
        outline: none;
      }
      .theme-rgb-input:focus {
        border-color: var(--accent);
      }
      :global(.shelf-undo-stack) {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: min(32rem, calc(100vw - 2rem));
        transform: translateX(-50%);
        pointer-events: none;
      }
      :global(.shelf-undo-toast) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem 1rem;
        pointer-events: auto;
        border: 1px solid var(--border-dark);
        border-radius: 12px;
        background: var(--surface-dark);
        color: var(--text-dark);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        font-size: 0.85rem;
      }
      :global(.shelf-undo-toast button) {
        flex: 0 0 auto;
        padding: 0.35rem 0.7rem;
        border: 0;
        border-radius: 7px;
        background: var(--accent);
        color: var(--accent-ink);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      :global(.shelf-undo-toast span) {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      :global(.shelf-undo-toast button:hover) {
        background: var(--accent-strong);
      }
      @media (max-width: 700px) {
        :global(.shelf-undo-stack) {
          bottom: 5.5rem;
        }
      }
      #open-library-sync-dialog {
        width: min(28rem, calc(100vw - 2rem));
        max-width: none;
        padding: 1.4rem;
        border: 1px solid var(--border-dark);
        border-radius: 14px;
        background: var(--surface-dark);
        color: var(--text-dark);
        font-family: var(--font-sans);
        box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
      }
      #open-library-sync-dialog::backdrop {
        background: rgba(0, 0, 0, 0.6);
      }
      .open-library-sync-form {
        display: grid;
        gap: 0.75rem;
      }
      .open-library-sync-form h2 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 400;
        line-height: 1.1;
      }
      .open-library-sync-form p {
        margin: 0;
        color: var(--text-dark-muted);
        font-size: 0.86rem;
        line-height: 1.55;
      }
      .open-library-sync-form label {
        margin-top: 0.35rem;
        font-size: 0.82rem;
        font-weight: 600;
      }
      .open-library-sync-form input {
        box-sizing: border-box;
        width: 100%;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--border-dark);
        border-radius: 9px;
        background: var(--surface-dark-2);
        color: var(--text-dark);
        font: inherit;
        font-size: 0.92rem;
        outline: none;
      }
      .open-library-sync-form input:focus {
        border-color: var(--accent);
      }
      .open-library-sync-message {
        min-height: 1.25rem;
      }
      .open-library-sync-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 0.35rem;
      }
      .open-library-sync-actions button {
        min-height: 2.4rem;
        padding: 0.45rem 0.85rem;
        border: 1px solid var(--border-dark);
        border-radius: 9px;
        background: transparent;
        color: var(--text-dark);
        font: inherit;
        font-size: 0.85rem;
        cursor: pointer;
      }
      .open-library-sync-actions button[type="submit"] {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--accent-ink);
        font-weight: 600;
      }
      .open-library-sync-actions button:disabled {
        opacity: 0.6;
        cursor: progress;
      }
      main {
        min-width: 0;
        padding: 2rem 2.5rem 3rem;
      }
      .category-panel {
        display: none;
        width: 100%;
      }
      .category-panel.active {
        display: block;
      }
      :global(.panel-heading) {
        margin-bottom: 1.25rem;
      }
      :global(.panel-heading h2) {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .shelf-jump-button {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 30;
        display: grid;
        width: 2.75rem;
        height: 2.75rem;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-ink);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
        font-size: 1.3rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
      }
      .shelf-jump-button:hover {
        background: var(--accent-strong);
      }
      .shelf-jump-button:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
        outline-offset: 3px;
      }
      .shelf-jump-button[hidden] {
        display: none;
      }
      .controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) max-content max-content max-content max-content;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        box-sizing: border-box;
        margin-bottom: 1.75rem;
        padding: 0.75rem;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--fill);
      }
      .category-panel.selection-mode .controls {
        grid-template-columns: minmax(0, 1fr) max-content max-content max-content;
        grid-template-rows: auto auto;
      }
      .category-panel.selection-mode .filter-input-wrap {
        grid-column: 1;
        grid-row: 1;
      }
      .category-panel.selection-mode .sort-select {
        grid-column: 2;
        grid-row: 1;
      }
      .category-panel.selection-mode .language-select {
        grid-column: 3;
        grid-row: 1;
      }
      .category-panel.selection-mode .reset-filters-button {
        grid-column: 4;
        grid-row: 1;
      }
      .batch-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin: 0;
      }
      .category-panel.selection-mode .batch-controls {
        grid-column: 1 / -1;
        grid-row: 2;
        width: 100%;
        box-sizing: border-box;
        flex-wrap: wrap;
        padding: 0.5rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--fill);
      }
      .batch-controls[hidden],
      .batch-actions[hidden] {
        display: none;
      }
      .batch-controls[hidden] {
        display: flex;
        visibility: hidden;
      }
      .batch-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .category-panel.selection-mode .batch-actions {
        flex: 1 1 auto;
      }
      .batch-controls button,
      .batch-controls select {
        height: 2.5rem;
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--fill);
        color: var(--fg);
        font: inherit;
        font-size: 0.85rem;
      }
      .batch-controls button:hover:not(:disabled) {
        background: var(--fill-strong);
      }
      .batch-controls button {
        cursor: pointer;
      }
      .batch-controls button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .batch-controls .batch-remove {
        border-color: color-mix(in srgb, var(--danger) 45%, transparent);
        color: var(--danger);
      }
      .batch-select-all,
      .batch-move-control {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        font-size: 0.8rem;
      }
      .batch-select-all {
        min-height: 2.5rem;
        box-sizing: border-box;
        padding: 0.45rem 0.65rem;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--fill);
      }
      .selection-count {
        display: inline-flex;
        min-height: 2.5rem;
        box-sizing: border-box;
        align-items: center;
        padding: 0.45rem 0.65rem;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--fill);
      }
      .batch-select-all input,
      :global(.local-book-select input) {
        width: 1rem;
        height: 1rem;
        accent-color: var(--accent);
      }
      .search-input,
      .sort-select,
      .language-select {
        height: 2.5rem;
        box-sizing: border-box;
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--fill);
        color: var(--fg);
        font: inherit;
        font-size: 0.85rem;
        outline: none;
      }
      .search-input::placeholder {
        color: var(--faint);
      }
      /* Selects use translucent fills, which some browsers' native option lists can't show. */
      :global(select option) {
        background-color: var(--page-background, #1c1c1c);
        color: var(--fg);
      }
      .sort-select:disabled,
      .language-select:disabled {
        opacity: 0.55;
      }
      .reset-filters-button {
        height: 2.5rem;
        padding: 0.45rem 0.75rem;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
      }
      .reset-filters-button:hover:not(:disabled) {
        background: var(--fill-strong);
        color: var(--fg);
      }
      .reset-filters-button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .search-input {
        flex: 1;
      }
      .filter-input-wrap {
        position: relative;
        min-width: 0;
      }
      .filter-input-wrap .search-input {
        width: 100%;
        padding-right: 2.5rem;
      }
      .filter-clear-button {
        position: absolute;
        top: 50%;
        right: 0.55rem;
        display: grid;
        width: 1.75rem;
        height: 1.75rem;
        place-items: center;
        box-sizing: border-box;
        padding: 0 0 0.2rem;
        transform: translateY(-50%);
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
      }
      .filter-clear-button:hover {
        background: var(--fill-strong);
        color: var(--fg);
      }
      .filter-clear-button[hidden] {
        display: none;
      }
      .sort-select,
      .language-select {
        width: auto;
      }
      .search-input:focus,
      .sort-select:focus,
      .language-select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
      }
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
        gap: 1.75rem 1.25rem;
      }
      :global(.card) {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        text-decoration: none;
      }
      :global(.card .cover-img),
      :global(.card .cover-placeholder) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 2 / 3;
        box-sizing: border-box;
        margin-bottom: 0.75rem;
        border-radius: 6px;
      }
      :global(.card .cover-img) {
        object-fit: contain;
        background: var(--page-background, #1c1c1c);
      }
      :global(.card .cover-placeholder) {
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed var(--line);
        background: var(--fill);
        color: var(--faint);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-align: center;
      }
      :global(.card h4) {
        margin: 0 0 0.2rem;
        color: var(--fg);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.3;
      }
      :global(.card .subtitle-text) {
        margin: 0 0 0.3rem;
        color: var(--muted);
        font-size: 0.8rem;
        line-height: 1.35;
      }
      :global(.card .author-text) {
        display: block;
        margin: 0 0 0.2rem;
        color: var(--muted);
        font-size: 0.78rem;
      }
      :global(.card .pub-date-text) {
        margin: 0 0 0.45rem;
        color: var(--faint);
        font-size: 0.72rem;
      }
      :global(.author-search-link) {
        color: inherit;
        text-decoration: none;
      }
      :global(.author-search-link:hover) {
        color: var(--fg);
        text-decoration: underline;
      }
      :global(.card .edition-link-text) {
        margin: 0.1rem 0 0;
        font-size: 0.72rem;
      }
      :global(.card .edition-link-text a) {
        color: var(--muted);
      }
      :global(.card .edition-link-text a:hover) {
        color: var(--accent);
      }
      :global(.category-edition-preview) {
        display: grid;
        flex: 1 1 auto;
        min-height: 0;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 0.75rem;
      }
      :global(.category-edition-preview[hidden]) {
        display: none;
      }
      :global(.edition-summary[hidden]),
      :global(.edition-list[hidden]) {
        display: none;
      }
      :global(.category-edition-preview-back),
      :global(.edition-dialog-header .edition-dialog-close) {
        justify-self: start;
        height: 2.25rem;
        box-sizing: border-box;
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--border-dark);
        border-radius: 8px;
        background: var(--surface-dark-2);
        color: var(--text-dark);
        font: inherit;
        font-size: 0.85rem;
        line-height: 1.2;
        cursor: pointer;
      }
      :global(.category-edition-preview-details .shelf-primary) {
        flex: 1;
        min-width: 0;
        padding: 0.4rem 0.65rem;
      }
      :global(.category-edition-actions) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        width: min(16.5rem, 100%);
        max-width: 100%;
        margin-top: 0.75rem;
      }
      :global(.category-edition-shelf-actions) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        max-width: 100%;
      }
      :global(.category-edition-actions .category-edition-open-link),
      :global(.category-edition-actions .shelf-control) {
        width: min(9.75rem, 100%);
        max-width: 100%;
        height: 2.25rem;
        box-sizing: border-box;
      }
      :global(.category-edition-actions .shelf-control > button) {
        min-height: 0;
        height: 100%;
        box-sizing: border-box;
      }
      :global(.category-edition-delete) {
        min-height: 0;
        height: 2.25rem;
        box-sizing: border-box;
        padding: 0 0.65rem;
        border: 1px solid var(--border-dark);
        border-radius: 8px;
        background: var(--surface-dark-2);
        color: var(--danger);
        font: inherit;
        font-size: 0.78rem;
        white-space: nowrap;
        cursor: pointer;
      }
      :global(.category-edition-delete:hover) {
        border-color: color-mix(in srgb, var(--danger) 55%, var(--border-dark));
        background: color-mix(in srgb, var(--danger) 10%, var(--surface-dark-2));
      }
      :global(.category-edition-delete[hidden]) {
        display: none;
      }
      :global(.edition-dialog.saved-book-detail-dialog) {
        width: min(48rem, calc(100% - 2rem));
        max-height: min(84vh, 48rem);
      }
      :global(.category-edition-preview-body) {
        display: grid;
        min-height: 0;
        grid-template-columns: minmax(8rem, 0.8fr) minmax(0, 1.2fr);
        align-items: start;
        align-content: start;
        gap: 1.25rem;
        overflow-y: auto;
      }
      :global(.category-edition-preview-cover) {
        display: block;
        width: 100%;
        height: auto;
        max-height: min(56vh, 32rem);
        align-self: start;
        border-radius: 6px;
        background: transparent;
        object-fit: contain;
        object-position: top center;
      }
      :global(.category-book-detail-no-cover) {
        display: flex;
        aspect-ratio: 2 / 3;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        padding: 1rem;
        color: var(--text-dark-muted);
        font-size: 0.75rem;
        text-align: center;
      }
      :global(.category-edition-preview-cover.category-book-detail-no-cover) {
        width: min(12rem, 100%);
        justify-self: center;
        border: 1px dashed var(--border-dark);
        border-radius: 6px;
        background: var(--surface-dark-2);
      }
      :global(.category-book-detail-author) {
        margin: 0.35rem 0 0;
        color: var(--text-dark-muted);
        font-size: 0.85rem;
      }
      :global(.category-edition-preview-details h4) {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.3;
      }
      :global(.category-edition-preview-subtitle) {
        margin: 0.35rem 0 0;
        color: var(--text-dark-muted);
        font-size: 0.85rem;
      }
      :global(.category-edition-preview-meta) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        margin: 1rem 0;
      }
      :global(.category-edition-preview-meta div) {
        min-width: 0;
      }
      :global(.category-edition-preview-meta dt) {
        color: var(--text-dark-muted);
        font-size: 0.7rem;
      }
      :global(.category-edition-preview-meta dd) {
        margin: 0.2rem 0 0;
        overflow-wrap: anywhere;
        font-size: 0.82rem;
      }
      :global(.category-edition-open-link) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.2rem;
        box-sizing: border-box;
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--border-dark);
        border-radius: 8px;
        background: var(--surface-dark-2);
        color: var(--text-dark);
        font-size: 0.8rem;
        text-decoration: none;
      }
      :global(.category-edition-open-link:hover) {
        border-color: var(--accent);
        color: var(--accent);
      }
      :global(.card .open-library-removed) {
        display: inline-block;
        margin: 0.35rem 0 0;
        padding: 0.2rem 0.45rem;
        border-radius: 6px;
        background: var(--fill-strong);
        color: var(--muted);
        font-size: 0.68rem;
      }
      :global(.local-book-select) {
        display: none;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted);
        font-size: 0.75rem;
      }
      :global(.selection-mode .local-book-select) {
        display: flex;
      }
      :global(.selection-mode .local-book-card) {
        cursor: pointer;
      }
      :global(.selection-mode .local-book-card:hover) {
        border-radius: 8px;
        outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
        outline-offset: 6px;
      }
      .empty-msg {
        color: var(--faint);
        font-size: 0.9rem;
      }
      .shelf-indicator {
        display: block;
        margin-top: 0.75rem;
        padding: 0.45rem 0.55rem;
        border-radius: 8px;
        background: var(--accent);
        color: var(--accent-ink);
        font-size: 0.78rem;
        font-weight: 600;
        text-align: center;
      }
      .mobile-nav {
        display: none;
      }
      :global(.search-card img),
      :global(.card .cover-img) {
        cursor: zoom-in;
      }
      :global(.selection-mode .card .cover-img) {
        cursor: pointer;
      }
      :global(.cover-lightbox) {
        max-width: 90vw;
        max-height: 90vh;
        padding: 0;
        border: 0;
        outline: none;
        border-radius: 8px;
        background: transparent;
        overflow: visible;
        cursor: zoom-out;
      }
      :global(.book-detail-cover-zoom) {
        min-width: 0;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        align-self: start;
        cursor: zoom-in;
      }
      :global(.book-detail-cover-zoom:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      :global(.cover-lightbox::backdrop) {
        background: rgba(0, 0, 0, 0.8);
      }
      :global(.cover-lightbox img) {
        display: block;
        width: auto;
        height: min(85vh, 48rem);
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }

      @media (max-width: 700px) {
        .container {
          display: block;
          min-height: 0;
        }
        sidebar {
          position: relative;
          z-index: 15;
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          gap: 1rem;
          height: auto;
          padding: 1.1rem 1rem 0.5rem;
          border-right: 0;
          background: transparent;
        }
        sidebar > .sidebar-section {
          display: none;
        }
        header h1 {
          padding: 0;
          font-size: 1.65rem;
        }
        .theme-picker {
          margin-top: 0;
        }
        .appearance-toggle {
          justify-content: center;
          width: 2.25rem;
          height: 2.25rem;
          padding: 0;
          border-radius: 50%;
        }
        :global(.category-edition-preview-body) {
          grid-template-columns: minmax(0, 1fr);
        }
        :global(.edition-dialog.saved-book-detail-dialog) {
          width: calc(100% - 1rem);
          max-height: calc(100vh - 1rem);
        }
        :global(.category-edition-preview-cover) {
          width: min(14rem, 100%);
          max-height: min(42vh, 22rem);
          justify-self: center;
        }
        .appearance-label,
        .appearance-value {
          display: none;
        }
        .appearance-swatch {
          width: 1.05rem;
          height: 1.05rem;
        }
        .appearance-panel {
          top: calc(100% + 0.5rem);
          bottom: auto;
          left: auto;
          width: 15rem;
        }
        main {
          padding: 0.75rem 1rem 6.5rem;
        }
        :global(.panel-heading) {
          margin-bottom: 1rem;
        }
        :global(.panel-heading h2) {
          font-size: 1.35rem;
        }
        .mobile-nav {
          position: fixed;
          right: 0;
          bottom: 0;
          left: 0;
          z-index: 10;
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 0.15rem;
          padding: 0.4rem 0.4rem calc(0.4rem + env(safe-area-inset-bottom));
          border-top: 1px solid var(--line);
          background: color-mix(in srgb, var(--page-background, #1c1c1c) 92%, transparent);
          -webkit-backdrop-filter: blur(14px);
          backdrop-filter: blur(14px);
        }
        .shelf-jump-button {
          right: 1rem;
          bottom: 5.5rem;
        }
        .controls {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 0.5rem;
          margin-bottom: 1.25rem;
        }
        .category-panel.selection-mode .controls {
          display: flex;
          flex-direction: column;
          align-items: stretch;
        }
        .batch-controls,
        .batch-actions {
          width: 100%;
        }
        .batch-controls[hidden] {
          width: auto;
        }
        .batch-controls .search-input {
          box-sizing: border-box;
          flex: 1 1 100%;
          min-width: 0;
          width: 100%;
        }
        .batch-actions {
          gap: 0.35rem;
        }
        .category-panel.selection-mode .batch-controls {
          align-items: stretch;
          flex-direction: column;
        }
        .batch-controls button,
        .batch-controls select {
          font-size: 0.8rem;
        }
        .sort-select {
          width: 100%;
        }
        .language-select {
          width: 100%;
        }
        .reset-filters-button {
          align-self: flex-start;
        }
        .cards-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 1.5rem 0.9rem;
        }
        .mobile-nav-button {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 0.25rem;
          min-width: 0;
          min-height: 3rem;
          padding: 0.3rem 0.15rem;
          border: 0;
          border-radius: 10px;
          background: transparent;
          color: var(--muted);
          font: inherit;
          font-size: 0.68rem;
          font-weight: 500;
          cursor: pointer;
        }
        .mobile-nav-button .category-count,
        .mobile-nav-icon {
          display: grid;
          place-items: center;
          min-width: 1.4rem;
          height: 1.4rem;
          box-sizing: border-box;
          margin: 0;
          padding: 0 0.3rem;
          border-radius: 999px;
          background: var(--fill-strong);
          color: var(--muted);
          font-size: 0.65rem;
        }
        .mobile-nav-icon svg {
          width: 0.75rem;
          height: 0.75rem;
        }
        .mobile-nav-button.open-library-button::before {
          width: 0.55rem;
          height: 0.55rem;
          margin: 0.42rem 0;
        }
        .mobile-nav-button.active {
          color: var(--fg);
          font-weight: 600;
        }
        .mobile-nav-button.active .category-count,
        .mobile-nav-button.active .mobile-nav-icon {
          background: var(--accent);
          color: var(--accent-ink);
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <sidebar>
        <header>
          <h1><a href="/?panel=search-db" class="home-link" id="home-link">My Reading <span class="title-accent">List</span></a></h1>
        </header>
        <div class="sidebar-section">
          <h3>Database</h3>
          <button class="category-btn search-tab active" data-target="search-db"
            ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>Search books</button
          >
          <button type="button" class="category-btn open-library-button" id="open-library-sync-button">
            Connect Open Library
          </button>
          <p class="open-library-sync-status" id="open-library-sync-status" role="status" aria-live="polite" hidden></p>
        </div>
        <div class="sidebar-section">
          <h3>My Lists</h3>
          <button class="category-btn" data-target="plan-to-read"
            >Plan to Read <span class="category-count">{planToRead.length}</span></button
          >
          <button class="category-btn" data-target="reading"
            >Reading <span class="category-count">{reading.length}</span></button
          >
          <button class="category-btn" data-target="read"
            >Read <span class="category-count">{read.length}</span></button
          >
        </div>
        <section class="theme-picker" aria-labelledby="theme-picker-title">
          <button type="button" class="appearance-toggle" id="appearance-toggle" aria-expanded="false" aria-controls="appearance-panel" aria-label="Appearance">
            <span class="appearance-swatch" aria-hidden="true"></span>
            <span class="appearance-label">Appearance</span>
            <span class="appearance-value" id="appearance-value" aria-hidden="true"></span>
          </button>
          <div class="appearance-panel" id="appearance-panel" hidden>
            <h3 id="theme-picker-title">Background</h3>
            <div class="theme-custom-controls">
              <input class="theme-color-input" id="theme-color-input" type="color" value="#1c1c1c" aria-label="Choose a custom background color" />
              <input class="theme-rgb-input" id="theme-rgb-input" type="text" inputmode="text" placeholder="RGB or #hex" aria-label="RGB values or hex color" autocomplete="off" />
            </div>
          </div>
        </section>
      </sidebar>

      <main>
        <!-- Dedicated Search Page Panel -->
        <div id="search-db" class="category-panel active">
          <BookSearch
            libraryBooks={allBooks.map(({ data }) => ({
              title: data.title,
              author: data.author,
              isbn: data.isbn,
              status: data.status,
              editionKey: (data as any).editionKey,
              editionLanguage: (data as any).editionLanguage || (data as any).language,
            }))}
          />
        </div>

        <!-- Personal Collection Panels -->
        {
          [
            {
              id: "plan-to-read",
              title: "Plan to Read",
              books: planToRead,
              empty: "No books planned yet.",
            },
            {
              id: "reading",
              title: "Reading",
              books: reading,
              empty: "No books currently being read.",
            },
            { id: "read", title: "Read", books: read, empty: "No completed books yet." },
          ].map(({ id, title, books, empty }) => (
            <div id={id} class="category-panel">
              <div class="panel-heading">
                <h2>{title}</h2>
              </div>
              <div class="controls">
                <div class="filter-input-wrap">
                  <input
                    type="text"
                    class="search-input"
                    placeholder="Filter by title, subtitle, author, or ISBN..."
                  />
                  <button type="button" class="filter-clear-button" aria-label="Clear filter" title="Clear filter" hidden>×</button>
                </div>
                <div class="batch-controls" hidden>
                  <button type="button" class="selection-toggle" aria-pressed="false">Select books</button>
                  <div class="batch-actions" hidden>
                    <label class="batch-select-all">
                      <input type="checkbox" class="select-all-checkbox" />
                      Select all
                    </label>
                    <span class="selection-count">0 selected</span>
                    <label class="batch-move-control">
                      Move to
                      <select class="batch-destination" disabled>
                        <option value="Plan to Read">Plan to Read</option>
                        <option value="Reading">Reading</option>
                        <option value="Read">Read</option>
                      </select>
                    </label>
                    <button type="button" class="batch-move" disabled>Move</button>
                    <button type="button" class="batch-remove" disabled>Delete</button>
                  </div>
                </div>
                <select class="sort-select">
                  <option value="date-added-desc">Date Added (newest)</option>
                  <option value="date-added-asc">Date Added (oldest)</option>
                  <option value="title-asc">Title: A to Z</option>
                  <option value="title-desc">Title: Z to A</option>
                  <option value="year-desc">Year: Newest First</option>
                  <option value="year-asc">Year: Oldest First</option>
                </select>
                <select class="language-select" aria-label="Filter this list by language">
                  <option value="">All languages</option>
                </select>
                <button type="button" class="reset-filters-button" disabled>Reset filters</button>
              </div>
              <div class="cards-grid">
                {books.map((book) => (
                  <a
                    href={`/blog/${book.id}/`}
                    class="card"
                    data-book-link
                    data-content-book
                    data-status={book.data.status || ""}
                    data-isbn={book.data.isbn || ""}
                    data-publisher={(book.data as any).publisher || ""}
                    data-edition-key={(book.data as any).editionKey || ""}
                    data-title={book.data.title.toLowerCase()}
                    data-subtitle={(book.data.subtitle || "").toLowerCase()}
                    data-author={(book.data.author || "").toLowerCase()}
                    data-year={parseInt(String(book.data.pubDate)) || 0}
                    data-date-added={(book.data as any).dateAdded || ""}
                    data-language={String((book.data as any).editionLanguage || (book.data as any).language || "").toLowerCase()}
                  >
                    <div>
                      {book.data.heroImage ? (
                        <img
                          src={book.data.heroImage}
                          class="cover-img"
                          alt={book.data.title}
                          referrerpolicy="no-referrer"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="cover-placeholder">
                          NO IMAGE
                          <br />
                          AVAILABLE
                        </div>
                      )}
                      <h4>{book.data.title}</h4>
                      {book.data.subtitle && (
                        <p class="subtitle-text">{book.data.subtitle}</p>
                      )}
                      <p class="author-text">
                        {splitAuthors(book.data.author || "Unknown Author").map((author, index) => (
                          author.toLowerCase() === "unknown author" ? (
                            <Fragment>
                              {index > 0 && ", "}
                              Unknown Author
                            </Fragment>
                          ) : (
                            <Fragment>
                              {index > 0 && ", "}
                              <a
                                href={`?panel=search-db&query=${encodeURIComponent(author)}&author=1&author_exact=1`}
                                class="author-search-link"
                                data-author-query={author}
                                data-author-exact="true"
                              >
                                {author}
                              </a>
                            </Fragment>
                          )
                        ))}
                      </p>
                      {book.data.pubDate && (
                        <p class="pub-date-text">
                          Published: {book.data.pubDate}
                        </p>
                      )}
                      <span class="shelf-indicator">
                        ✓ {book.data.status === "Plan to Read"
                          ? "Plan to Read"
                          : book.data.status === "Reading"
                            ? "Reading"
                            : "Read"}
                      </span>
                      <button
                        type="button"
                        class="edition-button category-edition-button"
                        data-title={book.data.title}
                        data-author={book.data.author || ""}
                        data-edition-key={(book.data as any).editionKey || ""}
                        data-edition-count={(book.data as any).editionCount || ""}
                        data-edition-language={(book.data as any).editionLanguage || ""}
                        data-status={book.data.status || ""}
                        data-hero-image={book.data.heroImage || ""}
                      >
                        {`Browse editions${(book.data as any).editionCount ? ` (${(book.data as any).editionCount})` : ""}`}
                      </button>
                    </div>
                  </a>
                ))}
              </div>

              {books.length === 0 && <p class="empty-msg">{empty}</p>}
              <p class="empty-msg no-match-msg" style="display: none;">
                No matching books found.
              </p>
            </div>
          ))
        }
      </main>
    </div>

    <nav class="mobile-nav" aria-label="Reading lists">
      <button class="mobile-nav-button active" data-target="search-db"><span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg></span>Search</button>
      <button class="mobile-nav-button" data-target="plan-to-read" aria-label="Plan to Read"><span class="category-count">{planToRead.length}</span>Plan</button>
      <button class="mobile-nav-button" data-target="reading"><span class="category-count">{reading.length}</span>Reading</button>
      <button class="mobile-nav-button" data-target="read"><span class="category-count">{read.length}</span>Read</button>
      <button type="button" class="mobile-nav-button open-library-button" id="mobile-open-library-sync-button">Connect</button>
    </nav>

    <!-- Avoids "back to top" class/label text that ad blockers (e.g. Brave Shields) hide. -->
    <button type="button" class="shelf-jump-button" aria-label="Jump to start of list" title="Jump to start of list" hidden>↑</button>

    <dialog id="open-library-sync-dialog" aria-labelledby="open-library-sync-title">
      <form class="open-library-sync-form" id="open-library-sync-form">
        <h2 id="open-library-sync-title">Connect Open Library</h2>
        <p>Enter your Open Library username. Your reading log must be public to sync, and no password is needed.</p>
        <p>Only one account can be synced at a time. Switching accounts replaces its synced books, while books added only here stay.</p>
        <label for="open-library-username">Open Library username</label>
        <input id="open-library-username" name="username" type="text" autocomplete="username" required />
        <p class="open-library-sync-message" id="open-library-sync-message" role="status" aria-live="polite"></p>
        <div class="open-library-sync-actions">
          <button type="button" id="open-library-sync-cancel">Cancel</button>
          <button type="submit" id="open-library-sync-submit">Connect and sync</button>
        </div>
      </form>
    </dialog>

    <script>
      const buttons = document.querySelectorAll(
        ".category-btn, .mobile-nav-button",
      );
      const panels = document.querySelectorAll(".category-panel");
      const backToTopButton = document.querySelector<HTMLButtonElement>(
        ".shelf-jump-button",
      );
      const savedBooksKey = "my-book-library:books";
      const legacySavedBooksKey = "my-book-library:plan-to-read";
      const openLibraryUsernameKey = "my-book-library:openlibrary-username";
      // v2 forces one re-sync so earlier synced books get their real Open Library dates.
      const openLibraryLastSyncKey = "my-book-library:openlibrary-last-sync-v2";
      localStorage.removeItem("my-book-library:openlibrary-last-sync");
      const openLibraryLastSyncResultKey = "my-book-library:openlibrary-last-sync-result";
      const openLibrarySyncInterval = 12 * 60 * 60 * 1000;
      const openLibrarySyncButton = document.getElementById("open-library-sync-button") as HTMLButtonElement;
      const mobileOpenLibrarySyncButton = document.getElementById("mobile-open-library-sync-button") as HTMLButtonElement;
      const openLibrarySyncStatus = document.getElementById("open-library-sync-status") as HTMLElement;
      const openLibrarySyncDialog = document.getElementById("open-library-sync-dialog") as HTMLDialogElement;
      const openLibrarySyncForm = document.getElementById("open-library-sync-form") as HTMLFormElement;
      const openLibraryUsernameInput = document.getElementById("open-library-username") as HTMLInputElement;
      const openLibrarySyncMessage = document.getElementById("open-library-sync-message") as HTMLElement;
      const openLibrarySyncSubmit = document.getElementById("open-library-sync-submit") as HTMLButtonElement;
      const openLibrarySyncCancel = document.getElementById("open-library-sync-cancel") as HTMLButtonElement;
      // v2: the old key auto-saved white on every load, so it can't tell a real choice from the old default.
      const backgroundPreferenceKey = "my-book-library:page-background-v2";
      localStorage.removeItem("my-book-library:page-background");
      const backgroundColorInput = document.getElementById("theme-color-input") as HTMLInputElement;
      const backgroundRgbInput = document.getElementById("theme-rgb-input") as HTMLInputElement;
      const appearanceToggle = document.getElementById("appearance-toggle") as HTMLButtonElement;
      const appearancePanel = document.getElementById("appearance-panel") as HTMLElement;
      const appearanceValue = document.getElementById("appearance-value") as HTMLElement;
      const savedBackground = localStorage.getItem(backgroundPreferenceKey);
      const selectedBackground = /^#[0-9a-f]{6}$/i.test(savedBackground || "")
        ? savedBackground || "#1c1c1c"
        : "#1c1c1c";
      function setPageForeground(background: string) {
        const channels = background.match(/[0-9a-f]{2}/gi)?.map((channel) => parseInt(channel, 16) / 255) || [1, 1, 1];
        const luminance = channels
          .map((channel) => channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4)
          .reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);
        const darkContrast = (luminance + 0.05) / 0.058;
        const lightContrast = 1.05 / (luminance + 0.05);
        document.body.style.setProperty(
          "--page-foreground",
          lightContrast > darkContrast ? "#ffffff" : "#0f172a",
        );
        document.documentElement.style.colorScheme = lightContrast > darkContrast ? "dark" : "light";
      }

      function setPageBackground(background: string, persist = true) {
        document.body.style.backgroundColor = background;
        setPageForeground(background);
        if (persist) localStorage.setItem(backgroundPreferenceKey, background);
        backgroundColorInput.value = background;
        const rgb = background.match(/[0-9a-f]{2}/gi) || [];
        backgroundRgbInput.value = rgb.map((value) => parseInt(value, 16)).join(", ");
        backgroundRgbInput.setCustomValidity("");
        document.body.style.setProperty("--page-background", background);
        appearanceValue.textContent = backgroundRgbInput.value;
      }

      setPageBackground(selectedBackground, false);

      function setAppearanceOpen(open: boolean) {
        appearancePanel.hidden = !open;
        appearanceToggle.setAttribute("aria-expanded", String(open));
      }
      appearanceToggle.addEventListener("click", () =>
        setAppearanceOpen(appearanceToggle.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("click", (event) => {
        if (!appearancePanel.hidden && !(event.target as Element).closest?.(".theme-picker")) {
          setAppearanceOpen(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !appearancePanel.hidden) {
          setAppearanceOpen(false);
          appearanceToggle.focus();
        }
      });

      backgroundColorInput.addEventListener("input", () => {
        setPageBackground(backgroundColorInput.value);
      });
      backgroundRgbInput.addEventListener("change", () => {
        const inputValue = backgroundRgbInput.value.trim();
        const hexValue = inputValue.match(/^#?([0-9a-f]{3}|[0-9a-f]{6})$/i)?.[1];
        const rgbValues = inputValue.match(/^rgb\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*\)$/i)
          || inputValue.match(/^(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})$/);
        const channels = rgbValues?.slice(1).map(Number);
        if (!hexValue && (!channels || channels.some((channel) => channel > 255))) {
          backgroundRgbInput.setCustomValidity("Enter a hex color or three RGB values from 0 to 255.");
          backgroundRgbInput.reportValidity();
          return;
        }
        if (hexValue) {
          const fullHex = hexValue.length === 3
            ? hexValue.split("").map((channel) => channel + channel).join("")
            : hexValue;
          setPageBackground(`#${fullHex.toLowerCase()}`);
        } else {
          setPageBackground(`#${channels?.map((channel) => channel.toString(16).padStart(2, "0")).join("")}`);
        }
      });
      const shelfDefinitions = [
        { id: "plan-to-read", status: "Plan to Read", label: "Plan to Read" },
        { id: "reading", status: "Reading", label: "Reading" },
        { id: "read", status: "Read", label: "Read" },
      ];
      const serverShelfCounts = new Map<string, number>();
      const panelRefreshers = new Map<string, () => void>();
      const panelLanguageLoaders = new Map<string, () => void>();
      const editionLanguageCacheKey = "my-book-library:edition-languages";
      function normalizeEditionId(value: string) {
        return String(value || "").match(/OL\d+M/i)?.[0].toUpperCase() || "";
      }
      const detailLanguageNames = new Intl.DisplayNames(["en"], { type: "language", fallback: "none" });
      const customDetailLanguageNames: Record<string, string> = {
        cpf: "French-based Creole", mul: "Multiple languages", tib: "Tibetan", tlh: "Klingon",
        zxx: "No linguistic content",
      };
      function getDetailLanguageName(value: string) {
        const code = String(value || "").trim().toLowerCase();
        if (!code || ["und", "unknown", "unknown language"].includes(code)) return "Unknown";
        if (customDetailLanguageNames[code]) return customDetailLanguageNames[code];
        try {
          return detailLanguageNames.of(code) || value;
        } catch {
          return value;
        }
      }
      function isKnownEditionLanguage(value: unknown): value is string {
        return typeof value === "string" && Boolean(value.trim()) && value.trim().toLowerCase() !== "unknown";
      }
      let editionLanguageCache: Record<string, string> = {};
      try {
        const cachedLanguages = JSON.parse(localStorage.getItem(editionLanguageCacheKey) || "{}");
        if (cachedLanguages && typeof cachedLanguages === "object") {
          editionLanguageCache = Object.fromEntries(
            Object.entries(cachedLanguages).filter(([, language]) => isKnownEditionLanguage(language)),
          ) as Record<string, string>;
        }
        localStorage.setItem(editionLanguageCacheKey, JSON.stringify(editionLanguageCache));
      } catch {
        editionLanguageCache = {};
      }
      let languageLoadPromise: Promise<void> | null = null;
      let lastLanguageLoadAt = 0;

      const previousSyncWarning = localStorage.getItem(openLibraryLastSyncResultKey) || "";
      if (/books were not returned by Open Library/.test(previousSyncWarning)) {
        localStorage.removeItem(openLibraryLastSyncResultKey);
      }

      shelfDefinitions.forEach(({ id }) => {
        serverShelfCounts.set(
          id,
          Number(document.querySelector(`[data-target="${id}"] .category-count`)?.textContent || "0"),
        );
      });

      function isShelfStatus(status: string) {
        return shelfDefinitions.some((shelf) => shelf.status === status);
      }

      try {
        const storedBooks = localStorage.getItem(savedBooksKey);
        if (storedBooks !== null) {
          const parsedBooks = JSON.parse(storedBooks);
          var localBooks: any[] = Array.isArray(parsedBooks) ? parsedBooks : [];
        } else {
          const legacyBooks = JSON.parse(localStorage.getItem(legacySavedBooksKey) || "[]");
          var localBooks: any[] = Array.isArray(legacyBooks)
            ? legacyBooks.map((book: any) => ({ ...book, status: book.status || "Plan to Read" }))
            : [];
          localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
          localStorage.removeItem(legacySavedBooksKey);
        }
      } catch {
        var localBooks: any[] = [];
      }

      const existingAddedTimestamps = localBooks
        .map((book) => Number(book.dateAdded))
        .filter((dateAdded) => Number.isFinite(dateAdded) && dateAdded > 0);
      const legacyDateBase = (existingAddedTimestamps.length > 0
        ? Math.min(...existingAddedTimestamps)
        : Date.now()) - localBooks.length - 1;
      let migratedAddedDates = false;
      localBooks.forEach((book, index) => {
        if (Number.isFinite(Number(book.dateAdded)) && Number(book.dateAdded) > 0) return;
        book.dateAdded = legacyDateBase + index;
        migratedAddedDates = true;
      });
      if (migratedAddedDates) {
        localStorage.setItem(savedBooksKey, JSON.stringify(localBooks));
      }

      function getBookIdentity(book: any) {
        return book.editionKey || book.key || book.isbn || `${book.title}:${book.author}`;
      }

      function isSameBook(first: any, second: any) {
        if (first.editionKey || second.editionKey) {
          return Boolean(first.editionKey && second.editionKey && first.editionKey === second.editionKey);
        }
        if (first.workKey && second.workKey && first.workKey === second.workKey) return true;
        if (first.workKey && first.workKey === second.key) return true;
        if (second.workKey && second.workKey === first.key) return true;
        if (first.key && second.key && first.key === second.key) return true;

        const normalize = (value: string) => String(value || "")
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]/g, "");
        const firstIsbn = normalize(first.isbn);
        const secondIsbn = normalize(second.isbn);

        if (firstIsbn && secondIsbn && firstIsbn === secondIsbn) return true;

        const firstTitle = normalize(first.title);
        const secondTitle = normalize(second.title);
        const firstAuthors = String(first.author || "")
          .split(/,|&|\band\b/i)
          .map(normalize)
          .filter(Boolean);
        const secondAuthors = String(second.author || "")
          .split(/,|&|\band\b/i)
          .map(normalize)
          .filter(Boolean);

        return Boolean(
          firstTitle &&
          firstTitle === secondTitle &&
          firstAuthors.some((author) => secondAuthors.includes(author)),
        );
      }

      function removeMatchingContentBooks(book: any) {
        document.querySelectorAll<HTMLElement>("[data-content-book]").forEach((card) => {
          const contentBook = {
            title: card.dataset.title,
            author: card.dataset.author,
            isbn: card.dataset.isbn,
          };
          if (!isSameBook(book, contentBook)) return;

          const oldShelf = shelfDefinitions.find((shelf) => shelf.status === card.dataset.status);
          if (oldShelf) {
            serverShelfCounts.set(
              oldShelf.id,
              Math.max(0, (serverShelfCounts.get(oldShelf.id) || 0) - 1),
            );
          }
          card.remove();
        });
      }

      function createShelfControl(book: any) {
        const control = document.createElement("div");
        control.className = "shelf-control is-saved";

        const currentShelf = shelfDefinitions.find((shelf) => shelf.status === book.status)
