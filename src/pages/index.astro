        appendAuthorLinks(details, book.author || "Unknown Author");
        if (book.pubDate) {
          const pubDate = document.createElement("p");
          pubDate.className = "pub-date-text";
          pubDate.textContent = `Published: ${book.pubDate}`;
          details.appendChild(pubDate);
