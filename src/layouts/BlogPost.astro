---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, author, isbn } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
      }

      .hero-image img {
        display: block;
        width: auto;
        max-width: 320px; /* Limits overall cover size */
        max-height: 480px;
        height: auto;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12); /* Shadow wraps tightly around the image */
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1.4;
      }
      .title h1 {
        margin: 0.2em 0 0.5em 0;
      }
      .meta-info {
        margin-top: 0.25rem;
        font-size: 0.95rem;
        color: #64748b;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        align-items: center;
      }
      .meta-info strong {
        color: #64748b;
      }
      .meta-info p,
      .meta-info .date {
        margin: 0;
        line-height: 1.3;
      }
      .date {
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
        margin-top: 0.25rem;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <img
                src={
                  typeof heroImage === "string"
                    ? heroImage
                    : (heroImage as any)?.src
                }
                alt=""
                referrerpolicy="no-referrer"
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <h1>{title}</h1>
            <div class="meta-info">
              {
                author && (
                  <p>
                    <strong>Author(s):</strong> {author}
                  </p>
                )
              }
              {
                isbn && (
                  <p>
                    <strong>ISBN:</strong> {isbn}
                  </p>
                )
              }
              {
                pubDate && (
                  <div class="date">
                    <strong>Year:</strong> {pubDate}
                  </div>
                )
              }
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on {updatedDate}
                  </div>
                )
              }
            </div>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
