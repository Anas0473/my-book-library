---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, author, isbn } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: auto;
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
      }
      article {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 680px);
        gap: clamp(2rem, 6vw, 5rem);
        align-items: start;
        justify-content: center;
      }
      .hero-image {
        width: 100%;
        display: flex;
        justify-content: center;
        position: sticky;
        top: 2rem;
      }

      .hero-image img {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: 480px;
        height: auto;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.16);
      }
      .prose {
        width: auto;
        max-width: 680px;
        padding: 0;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin: 0 0 1.5rem;
        padding: 0.5rem 0 1.5rem;
        text-align: left;
        line-height: 1.25;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .title h1 {
        margin: 0 0 1.25rem;
        font-size: 2.5rem;
        letter-spacing: 0;
      }
      .meta-info {
        margin: 0;
        font-size: 1rem;
        color: #64748b;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        align-items: flex-start;
      }
      .meta-info strong {
        color: rgb(var(--gray-dark));
      }
      .meta-info p,
      .meta-info .date {
        margin: 0;
        line-height: 1.3;
      }
      .date {
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
        margin-top: 0.25rem;
      }

      @media (max-width: 720px) {
        main {
          padding: 2rem 1rem 3rem;
        }
        article {
          display: block;
        }
        .hero-image {
          position: static;
          margin-bottom: 2.5rem;
        }
        .hero-image img {
          max-width: min(280px, 85vw);
          max-height: 420px;
        }
        .prose {
          max-width: none;
        }
        .title {
          text-align: center;
        }
        .title h1 {
          font-size: 2rem;
        }
        .meta-info {
          align-items: center;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <img
                src={
                  typeof heroImage === "string"
                    ? heroImage
                    : (heroImage as any)?.src
                }
                alt=""
                referrerpolicy="no-referrer"
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <h1>{title}</h1>
            <div class="meta-info">
              {
                author && (
                  <p>
                    <strong>Author(s):</strong> {author}
                  </p>
                )
              }
              {
                isbn && (
                  <p>
                    <strong>ISBN:</strong> {isbn}
                  </p>
                )
              }
              {
                pubDate && (
                  <div class="date">
                    <strong>Year:</strong> {pubDate}
                  </div>
                )
              }
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on {updatedDate}
                  </div>
                )
              }
            </div>
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
