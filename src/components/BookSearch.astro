---
---

<div class="search-container">
  <input
    type="text"
    id="global-book-search"
    placeholder="Search books"
  />
  <div id="search-summary" class="search-summary"></div>
  <div id="search-results" class="results-grid"></div>
  <div id="pagination-controls" class="pagination"></div>
</div>

<style>
  .search-container {
    margin-bottom: 1.5rem;
  }
  #global-book-search {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    box-sizing: border-box;
  }
  #global-book-search:focus {
    border-color: #0070f3;
  }
  .search-summary {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #64748b;
  }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  :global(.pagination button) {
    padding: 0.4rem 0.9rem;
    border: 1px solid #cbd5e1;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
  }
  :global(.pagination button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.pagination button:hover:not(:disabled)) {
    background: #f8fafc;
    border-color: #94a3b8;
  }
  :global(.pagination span) {
    font-size: 0.85rem;
    color: #475569;
  }
  :global(.search-card) {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.8rem;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  :global(.search-card img) {
    width: 100%;
    height: 200px;
    object-fit: contain;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  :global(.search-card h5) {
    margin: 0 0 0.25rem 0;
    font-size: 0.9rem;
  }
  :global(.search-card p) {
    margin: 0 0 0.25rem 0;
    font-size: 0.75rem;
    color: #64748b;
  }
  :global(.search-card p.pub-date) {
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    color: #94a3b8;
  }
  :global(.add-btn) {
    background: #0070f3;
    color: white;
    border: none;
    padding: 0.4rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.8rem;
  }
  :global(.add-btn:hover) {
    background: #0051a2;
  }

  @media (max-width: 700px) {
    .results-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    :global(.search-card) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.65rem;
    }
    :global(.search-card > div) {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.75rem;
    }
    :global(.search-card img) {
      grid-row: 1 / 4;
      width: 76px;
      height: 110px;
    }
    :global(.search-card h5) {
      align-self: end;
      font-size: 0.8rem;
      line-height: 1.15;
    }
    :global(.search-card p) {
      font-size: 0.68rem;
    }
    :global(.search-card p.pub-date) {
      font-size: 0.62rem;
    }
    :global(.add-btn) {
      width: 100%;
      padding: 0.45rem;
      font-size: 0.72rem;
    }
    .pagination {
      gap: 0.5rem;
    }
    :global(.pagination button),
    :global(.pagination span) {
      font-size: 0.72rem;
    }
    :global(.pagination button) {
      padding: 0.35rem 0.6rem;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('global-book-search') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results') as HTMLElement;
  const summaryContainer = document.getElementById('search-summary') as HTMLElement;
  const paginationContainer = document.getElementById('pagination-controls') as HTMLElement;
  
  let debounceTimer: NodeJS.Timeout;
  let currentQuery = '';
  let currentPage = 1;
  const mobileBreakpoint = window.matchMedia('(max-width: 700px)');

  function getPageSize() {
    return mobileBreakpoint.matches ? 15 : 16;
  }

  async function performSearch(query: string, page: number = 1) {
    currentQuery = query;
    currentPage = page;
    const pageSize = getPageSize();

    resultsContainer.innerHTML = '<p>Searching...</p>';
    summaryContainer.innerHTML = '';
    paginationContainer.innerHTML = '';

    try {
      const res = await fetch(`/api/search-books.json?q=${encodeURIComponent(query)}&page=${page}&limit=${pageSize}`);
      const data = await res.json();

      const { books = [], totalResults = 0, totalPages = 0 } = data;

      if (!books || books.length === 0) {
        resultsContainer.innerHTML = '<p>No books found.</p>';
        return;
      }

      const startItem = (page - 1) * pageSize + 1;
      const endItem = Math.min(page * pageSize, totalResults);
      summaryContainer.innerHTML = `Showing ${startItem}–${endItem} of ${totalResults} results`;

      resultsContainer.innerHTML = books.map((book: any) => `
        <div class="search-card">
          <div>
            ${book.heroImage 
              ? `<img src="${book.heroImage}" alt="${book.title}" />` 
              : '<div style="height:200px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:0.75rem; margin-bottom:0.5rem; border-radius:4px;">NO IMAGE</div>'
            }
            <h5>${book.title}</h5>
            <p>${book.author || 'Unknown Author'}</p>
            <p class="pub-date">${book.pubDate ? `Published: ${book.pubDate}` : 'Publication date unknown'}</p>
          </div>
          <button class="add-btn">+ Add to List</button>
        </div>
      `).join('');

      if (totalPages > 1) {
        paginationContainer.innerHTML = `
          <button id="prev-page" ${page <= 1 ? 'disabled' : ''}>← Previous</button>
          <span>Page ${page} of ${totalPages}</span>
          <button id="next-page" ${page >= totalPages ? 'disabled' : ''}>Next →</button>
        `;

        document.getElementById('prev-page')?.addEventListener('click', () => {
          if (currentPage > 1) performSearch(currentQuery, currentPage - 1);
        });

        document.getElementById('next-page')?.addEventListener('click', () => {
          if (currentPage < totalPages) performSearch(currentQuery, currentPage + 1);
        });
      }
    } catch (err) {
      resultsContainer.innerHTML = '<p>An error occurred while fetching books.</p>';
    }
  }

  searchInput?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = searchInput.value.trim();

    if (query.length < 3) {
      resultsContainer.innerHTML = '';
      summaryContainer.innerHTML = '';
      paginationContainer.innerHTML = '';
      return;
    }

    debounceTimer = setTimeout(() => {
      performSearch(query, 1);
    }, 400);
  });

  mobileBreakpoint.addEventListener('change', () => {
    if (currentQuery) performSearch(currentQuery, 1);
  });
</script>