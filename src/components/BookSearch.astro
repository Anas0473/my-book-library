---
interface Props {
  libraryBooks?: Array<{
    title: string;
    author?: string;
    isbn?: string;
    status?: string;
    editionKey?: string;
  }>;
}

const { libraryBooks = [] } = Astro.props;
---

<div class="search-container" data-library-books={JSON.stringify(libraryBooks)}>
  <div class="search-controls">
    <div class="search-input-wrap">
      <input
        type="text"
        id="global-book-search"
        placeholder="Search by title, author, subtitle, or ISBN"
      />
      <button type="button" id="clear-book-search" class="search-clear-button" aria-label="Clear search" title="Clear search" hidden>×</button>
    </div>
    <select id="search-sort-select" aria-label="Sort search results">
      <option value="title-asc">Title: A to Z</option>
      <option value="title-desc">Title: Z to A</option>
      <option value="year-desc">Year: Newest First</option>
      <option value="year-asc">Year: Oldest First</option>
    </select>
    <select id="search-language-select" aria-label="Filter by language" disabled>
      <option value="">Languages found after searching</option>
    </select>
    <button type="button" id="reset-search-filters" class="search-reset-button" disabled>Reset filters</button>
  </div>
  <div id="search-summary" class="search-summary"></div>
  <div id="search-results" class="results-grid"></div>
  <div id="pagination-controls" class="pagination"></div>
</div>

<style>
  .search-container {
    margin-bottom: 1.5rem;
  }
  .search-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .search-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }
  #global-book-search {
    width: 100%;
    height: 3rem;
    padding: 0.8rem 2.5rem 0.8rem 1rem;
    font-size: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    box-sizing: border-box;
  }
  #global-book-search:focus {
    border-color: #0070f3;
  }
  .search-clear-button {
    position: absolute;
    top: 50%;
    right: 0.55rem;
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    box-sizing: border-box;
    padding: 0 0 0.2rem;
    transform: translateY(-50%);
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #64748b;
    font: inherit;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .search-clear-button:hover {
    background: #f1f5f9;
    color: #1e293b;
  }
  .search-clear-button[hidden] {
    display: none;
  }
  #search-sort-select {
    flex: 0 0 220px;
    height: 3rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    color: #334155;
    font-size: 0.9rem;
  }
  #search-language-select {
    flex: 0 0 220px;
    height: 3rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    color: #334155;
    font-size: 0.9rem;
  }
  .search-reset-button {
    flex: 0 0 auto;
    height: 3rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    color: #334155;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .search-reset-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .search-summary {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--page-foreground, #64748b);
  }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  :global(.pagination button) {
    padding: 0.4rem 0.9rem;
    border: 1px solid #cbd5e1;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
  }
  :global(.pagination button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.pagination button:hover:not(:disabled)) {
    background: #f8fafc;
    border-color: #94a3b8;
  }
  :global(.pagination span) {
    font-size: 0.85rem;
    color: #475569;
  }
  :global(.search-card) {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.8rem;
    background: #fff;
    color: #1e293b;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  :global(.search-card img) {
    width: 100%;
    height: 200px;
    object-fit: contain;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  :global(.search-cover-placeholder) {
    width: 100%;
    height: 200px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #94a3b8;
    font-size: 0.75rem;
  }
  :global(.search-card h5) {
    margin: 0 0 0.45rem 0;
    font-size: 0.9rem;
  }
  :global(.search-card p) {
    margin: 0 0 0.4rem 0;
    font-size: 0.75rem;
    color: #64748b;
  }
  :global(.search-card p.subtitle) {
    font-size: 0.82rem;
    line-height: 1.35;
  }
  :global(.search-card p.author-text) {
    margin-bottom: 0.55rem;
  }
  :global(.search-card p.pub-date) {
    margin-bottom: 0.75rem;
    font-size: 0.7rem;
    color: #94a3b8;
  }
  :global(.edition-button),
  :global(.selected-edition-link) {
    display: inline-block;
    margin: 0.2rem 0 0.5rem;
    color: #39745b;
    font-size: 0.7rem;
  }
  :global(.edition-button) {
    padding: 0;
    border: 0;
    background: transparent;
    text-decoration: underline;
    cursor: pointer;
  }
  :global(.selected-edition-link[hidden]) {
    display: none;
  }
  :global(.edition-dialog) {
    width: min(42rem, calc(100% - 2rem));
    max-height: min(80vh, 42rem);
    box-sizing: border-box;
    padding: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: #334155;
  }
  :global(.edition-dialog[open]) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  :global(.edition-dialog::backdrop) {
    background: rgba(15, 23, 42, 0.4);
  }
  :global(.edition-dialog-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  :global(.edition-dialog-header h3) {
    margin: 0;
    font-size: 1rem;
  }
  :global(.edition-summary) {
    margin: 0 0 0.75rem;
    color: #64748b;
    font-size: 0.8rem;
  }
  :global(.edition-view-all) {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    color: #39745b;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  :global(.edition-view-all:hover) {
    background: #f8fafc;
    border-color: #39745b;
  }
  :global(.edition-pagination) {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    color: #64748b;
    font-size: 0.8rem;
  }
  :global(.edition-pagination[hidden]) {
    display: none;
  }
  :global(.edition-pagination button) {
    padding: 0.35rem 0.65rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #fff;
    color: #334155;
    font: inherit;
    cursor: pointer;
  }
  :global(.edition-pagination button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.edition-dialog-close) {
    padding: 0.25rem 0.5rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }
  :global(.edition-list) {
    display: grid;
    flex: 1 1 auto;
    min-height: 0;
    gap: 0.65rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :global(.edition-option) {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: #fff;
    text-align: left;
    cursor: pointer;
  }
  :global(.edition-option:hover) {
    border-color: #39745b;
    background: #f8fafc;
  }
  :global(.edition-option img) {
    width: 3.5rem;
    height: 4.5rem;
    object-fit: contain;
    background: #f1f5f9;
  }
  :global(.edition-option strong),
  :global(.edition-option span) {
    display: block;
  }
  :global(.edition-option strong) {
    font-size: 0.8rem;
  }
  :global(.edition-choice-label) {
    color: #39745b !important;
    font-weight: 600;
    white-space: nowrap;
  }
  :global(.edition-option span) {
    margin-top: 0.2rem;
    color: #64748b;
    font-size: 0.7rem;
  }
  :global(.shelf-control) {
    display: flex;
    position: relative;
    width: 100%;
  }
  :global(.shelf-control button) {
    min-height: 2.25rem;
    border: 1px solid #39745b;
    background: #39745b;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
  }
  :global(.shelf-control .shelf-primary) {
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.1rem;
    font-size: 0.78rem;
    white-space: nowrap;
    border-radius: 5px 0 0 5px;
  }
  :global(.shelf-toggle) {
    width: 1.5rem;
    flex: 0 0 1.5rem;
    border-left-color: rgba(255, 255, 255, 0.35) !important;
    border-radius: 0 5px 5px 0;
  }
  :global(.shelf-control button:hover) {
    background: #2d604a;
  }
  :global(.shelf-menu) {
    position: absolute;
    top: calc(100% + 3px);
    right: 0;
    z-index: 5;
    width: max(100%, 180px);
    padding: 0.25rem;
    border: 1px solid #d6d3c8;
    border-radius: 5px;
    background: #fff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.14);
  }
  :global(.shelf-menu[hidden]) {
    display: none;
  }
  :global(.shelf-menu button) {
    width: 100%;
    min-height: 2.25rem;
    padding: 0.45rem 0.6rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: #334155;
    text-align: left;
  }
  :global(.shelf-menu button:hover),
  :global(.shelf-menu button[aria-current="true"]) {
    background: #f1f5f2;
    color: #244d3b;
  }
  :global(.shelf-menu-divider) {
    margin: 0.25rem 0;
    border-top: 1px solid #e2e8f0;
  }
  :global(.shelf-menu button[data-action="remove"]) {
    color: #b42318;
  }

  @media (max-width: 700px) {
    .search-controls {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    #search-sort-select {
      flex-basis: auto;
      width: 100%;
    }
    #search-language-select {
      flex-basis: auto;
      width: 100%;
    }
    .search-reset-button {
      width: 100%;
    }
    .results-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    :global(.search-card) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.65rem;
    }
    :global(.search-card > div) {
      min-width: 0;
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.75rem;
    }
    :global(.search-card .shelf-control) {
      min-width: 0;
    }
    :global(.search-card img) {
      grid-row: 1 / 4;
      width: 76px;
      height: 110px;
    }
    :global(.search-card h5) {
      align-self: end;
      font-size: 0.8rem;
      line-height: 1.15;
    }
    :global(.search-card p) {
      font-size: 0.68rem;
    }
    :global(.search-card p.subtitle) {
      font-size: 0.76rem;
      line-height: 1.3;
    }
    :global(.search-card p.pub-date) {
      font-size: 0.62rem;
    }
    :global(.shelf-control button) {
      font-size: 0.72rem;
    }
    :global(.shelf-control .shelf-primary) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pagination {
      gap: 0.5rem;
    }
    :global(.pagination button),
    :global(.pagination span) {
      font-size: 0.72rem;
    }
    :global(.pagination button) {
      padding: 0.35rem 0.6rem;
    }
  }
</style>

<script>
  const searchContainer = document.querySelector('.search-container') as HTMLElement;
  const searchInput = document.getElementById('global-book-search') as HTMLInputElement;
  const clearSearchButton = document.getElementById('clear-book-search') as HTMLButtonElement;
  const resetSearchFiltersButton = document.getElementById('reset-search-filters') as HTMLButtonElement;
  const searchSortSelect = document.getElementById('search-sort-select') as HTMLSelectElement;
  const searchLanguageSelect = document.getElementById('search-language-select') as HTMLSelectElement;
  const resultsContainer = document.getElementById('search-results') as HTMLElement;
  const summaryContainer = document.getElementById('search-summary') as HTMLElement;
  const paginationContainer = document.getElementById('pagination-controls') as HTMLElement;
  const editionDialog = document.createElement('dialog');
  editionDialog.className = 'edition-dialog search-edition-dialog';
  document.body.appendChild(editionDialog);
  resultsContainer.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.matches('.search-card img')) return;

    const placeholder = document.createElement('div');
    placeholder.className = 'search-cover-placeholder';
    placeholder.textContent = 'NO IMAGE';
    image.replaceWith(placeholder);
  }, true);
  const libraryBooks = JSON.parse(searchContainer.dataset.libraryBooks || '[]') as any[];
  
  let debounceTimer: NodeJS.Timeout;
  let currentQuery = '';
  let currentPage = 1;
  let currentSort = searchSortSelect.value;
  let currentLanguage = '';
  // Guards against an earlier, slower keystroke's search response overwriting a newer one.
  let searchRequestId = 0;
  let currentAuthorOnly = false;
  let currentAuthorKey = '';
  let currentAuthorExact = false;
  function updateSearchClearButton() {
    clearSearchButton.hidden = searchInput.value.length === 0;
  }
  function updateSearchResetButton() {
    resetSearchFiltersButton.disabled = !searchInput.value.trim()
      && searchSortSelect.value === 'title-asc'
      && !searchLanguageSelect.value;
  }
  const pageSize = 16;
  const savedBooksKey = 'my-book-library:books';
  const legacySavedBooksKey = 'my-book-library:plan-to-read';
  const shelfLabels: Record<string, string> = {
    'Plan to Read': 'Want to Read',
    Reading: 'Currently Reading',
    Read: 'Read',
  };
  function getSavedBooks() {
    try {
      const storedBooks = localStorage.getItem(savedBooksKey);
      if (storedBooks !== null) {
        const savedBooks = JSON.parse(storedBooks);
        return Array.isArray(savedBooks) ? savedBooks : [];
      }

      const legacyBooks = JSON.parse(localStorage.getItem(legacySavedBooksKey) || '[]');
      const savedBooks = Array.isArray(legacyBooks)
        ? legacyBooks.map((book: any) => ({ ...book, status: book.status || 'Plan to Read' }))
        : [];
      localStorage.setItem(savedBooksKey, JSON.stringify(savedBooks));
      localStorage.removeItem(legacySavedBooksKey);
      return savedBooks;
    } catch {
      return [];
    }
  }

  function isSameBook(first: any, second: any) {
    if (first.editionKey && second.editionKey) {
      const normalizeEditionKey = (value: string) =>
        String(value).match(/OL\d+M/i)?.[0].toUpperCase() || String(value).replace(/^\/+|\/+$/g, '');
      return normalizeEditionKey(first.editionKey) === normalizeEditionKey(second.editionKey);
    }
    if (first.workKey && second.workKey && first.workKey === second.workKey) return true;
    if (first.workKey && first.workKey === second.key) return true;
    if (second.workKey && second.workKey === first.key) return true;
    if (first.key && second.key && first.key === second.key) return true;

    const normalize = (value: string) => String(value || '')
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '');
    const firstIsbn = normalize(first.isbn);
    const secondIsbn = normalize(second.isbn);

    if (firstIsbn && secondIsbn && firstIsbn === secondIsbn) return true;

    const firstTitle = normalize(first.title);
    const secondTitle = normalize(second.title);
    const firstAuthors = String(first.author || '')
      .split(/,|&|\band\b/i)
      .map(normalize)
      .filter(Boolean);
    const secondAuthors = String(second.author || '')
      .split(/,|&|\band\b/i)
      .map(normalize)
      .filter(Boolean);

    return Boolean(
      firstTitle &&
      firstTitle === secondTitle &&
      firstAuthors.some((author: string) => secondAuthors.includes(author)),
    );
  }

  function saveBookToShelf(book: any, status: string) {
    const firstEditionKey = Array.isArray(book.editionKeys) ? book.editionKeys[0] : null;
    const selectedEditionKey = book.editionKey || firstEditionKey;
    const selectedEditionId = String(selectedEditionKey || "").match(/OL\d+M/i)?.[0].toUpperCase();
    let savedBook = {
      key: book.key || book.isbn || `${book.title}:${book.author}`,
      workKey: book.workKey,
      editionKey: book.editionKey || (selectedEditionId ? `/books/${selectedEditionId}` : undefined),
      editionUrl: book.editionUrl || (selectedEditionId ? `https://openlibrary.org/books/${selectedEditionId}` : undefined),
      editionHeroImage: book.editionHeroImage || (selectedEditionId
        ? `https://covers.openlibrary.org/b/olid/${selectedEditionId}-M.jpg?default=false`
        : undefined),
      editionLanguage: book.editionLanguage,
      editionCount: book.editionCount || 0,
      title: book.title,
      subtitle: book.subtitle,
      author: book.author,
      pubDate: book.pubDate,
      isbn: book.isbn,
      heroImage: book.heroImage,
      dateAdded: Number(book.dateAdded) || Date.now(),
      status,
    };
    const updatedBooks = getSavedBooks();
    const existingIndex = updatedBooks.findIndex((item: any) => isSameBook(item, savedBook));

    if (existingIndex >= 0) {
      const existingBook = updatedBooks[existingIndex];
      savedBook = {
        ...savedBook,
        ...existingBook,
        editionKey: existingBook.editionKey || savedBook.editionKey,
        editionUrl: existingBook.editionUrl || savedBook.editionUrl,
        editionHeroImage: existingBook.editionHeroImage || savedBook.editionHeroImage,
        dateAdded: existingBook.dateAdded || savedBook.dateAdded,
        status,
      };
      updatedBooks[existingIndex] = savedBook;
    } else {
      updatedBooks.push(savedBook);
    }

    localStorage.setItem(savedBooksKey, JSON.stringify(updatedBooks));
    window.dispatchEvent(new CustomEvent('library:book-shelf-changed', { detail: savedBook }));
    return savedBook;
  }

  function closeShelfMenus() {
    resultsContainer.querySelectorAll<HTMLElement>('.shelf-menu').forEach((menu) => {
      menu.hidden = true;
    });
    resultsContainer.querySelectorAll<HTMLButtonElement>('.shelf-toggle').forEach((toggle) => {
      toggle.setAttribute('aria-expanded', 'false');
    });
  }

  function splitAuthors(author: string) {
    return String(author || 'Unknown Author')
      .split(/\s*(?:,|&|\band\b)\s*/i)
      .map((name) => name.trim())
      .filter(Boolean);
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    }[character] || character));
  }

  function authorLinksMarkup(author: string) {
    const authors = splitAuthors(author);
    if (authors.length === 0 || authors.every((name) => name.toLowerCase() === 'unknown author')) {
      return 'Unknown Author';
    }

    return authors.map((name, index) => {
      if (name.toLowerCase() === 'unknown author') {
        return `${index > 0 ? ', ' : ''}Unknown Author`;
      }
      return `
      ${index > 0 ? ', ' : ''}<a
        href="?panel=search-db&query=${encodeURIComponent(name)}&author=1&author_exact=1"
        class="author-search-link"
        data-author-query="${escapeHtml(name)}"
        data-author-exact="true"
      >${escapeHtml(name)}</a>
    `;
    }).join('');
  }

  async function performSearch(
    query: string,
    page: number = 1,
    authorOnly = false,
    authorKey = '',
    authorExact = false,
    sort = currentSort,
    language = currentLanguage,
  ) {
    currentQuery = query;
    currentPage = page;
    currentSort = sort;
    currentLanguage = language;
    currentAuthorOnly = authorOnly;
    currentAuthorKey = authorKey;
    currentAuthorExact = authorExact;
    searchSortSelect.value = sort;
    searchLanguageSelect.value = language;
    updateSearchResetButton();

    resultsContainer.innerHTML = '<p>Searching...</p>';
    summaryContainer.innerHTML = '';
    paginationContainer.innerHTML = '';

    const requestId = ++searchRequestId;

    try {
      const authorParam = authorOnly ? '&author=1' : '';
      const authorKeyParam = authorKey ? `&author_key=${encodeURIComponent(authorKey)}` : '';
      const authorExactParam = authorExact ? '&author_exact=1' : '';
      const sortParam = `&sort=${encodeURIComponent(sort)}`;
      const languageParam = language ? `&language=${encodeURIComponent(language)}` : '';
      const res = await fetch(`/api/search-books.json?q=${encodeURIComponent(query)}${authorParam}${authorKeyParam}${authorExactParam}${sortParam}${languageParam}&discover_languages=1&page=${page}&limit=${pageSize}`);
      const data = await res.json();

      if (requestId !== searchRequestId) return;

      const { books = [], totalResults = 0, totalPages = 0, languages = [] } = data;
      const savedBooks = getSavedBooks();
      const normalizedQuery = query.toLowerCase();
      const normalizedIsbnQuery = query
        .replace(/^ISBN(?:-1[03])?\s*[:#]?\s*/i, '')
        .replace(/[\s-]/g, '')
        .toUpperCase();
      const localMatches = savedBooks.filter((book: any) => {
        const title = String(book.title || '').toLowerCase();
        const subtitle = String(book.subtitle || '').toLowerCase();
        const author = String(book.author || '').toLowerCase();
        const isbn = String(book.isbn || '').replace(/[\s-]/g, '').toUpperCase();
        const matchesIsbn = normalizedIsbnQuery.length >= 10 && isbn.includes(normalizedIsbnQuery);
        const matchesLanguage = !currentLanguage
          || (book.editionLanguage
            ? book.editionLanguage === currentLanguage
            : books.some((result: any) => isSameBook(result, book)));
        return matchesLanguage && (currentAuthorOnly
          ? author.includes(normalizedQuery)
          : title.includes(normalizedQuery)
            || subtitle.includes(normalizedQuery)
            || author.includes(normalizedQuery)
            || matchesIsbn);
      });
      const savedWorkKeys = new Set(
        localMatches.map((book: any) => book.workKey).filter(Boolean),
      );
      const workResults = books.filter((result: any) =>
        !savedWorkKeys.has(result.workKey || result.key),
      );
      // Prioritize saved editions on the first page so they aren't repeated on every page.
      const extraLocalMatches = page === 1
        ? localMatches.filter((book: any) => !workResults.some((result: any) => isSameBook(result, book)))
        : [];
      const displayBooks = [...extraLocalMatches, ...workResults];
      // Substitutions are 1-for-1 so they don't change the overall count.
      const displayTotalResults = Math.max(totalResults, displayBooks.length);
      const languageNames: Record<string, string> = {
        ara: 'Arabic', dan: 'Danish', deu: 'German', eng: 'English',
        fas: 'Persian', fin: 'Finnish', fra: 'French', heb: 'Hebrew',
        ita: 'Italian', jpn: 'Japanese', nld: 'Dutch', nor: 'Norwegian',
        por: 'Portuguese', spa: 'Spanish', swe: 'Swedish', tur: 'Turkish',
        und: 'Unknown',
      };
      searchLanguageSelect.innerHTML = '<option value="">All languages</option>';
      languages.forEach((code: string) => {
        const option = document.createElement('option');
        option.value = code;
        option.textContent = languageNames[code] || code.toUpperCase();
        searchLanguageSelect.appendChild(option);
      });
      searchLanguageSelect.disabled = languages.length === 0;
      searchLanguageSelect.value = languages.includes(language) ? language : '';
      currentLanguage = searchLanguageSelect.value;

      if (displayBooks.length === 0) {
        resultsContainer.innerHTML = '<p>No books found.</p>';
        return;
      }

      const startItem = (page - 1) * pageSize + 1;
      const endItem = startItem + displayBooks.length - 1;
      summaryContainer.innerHTML = `Showing ${startItem}–${endItem} of ${displayTotalResults} results`;

      resultsContainer.innerHTML = displayBooks.map((book: any, index: number) => {
        const matchedSavedBook = savedBooks.find((item: any) => isSameBook(item, book));
        const firstEditionKey = Array.isArray(book.editionKeys) ? book.editionKeys[0] : null;
        const savedEditionKey = matchedSavedBook?.editionKey || book.editionKey || firstEditionKey;
        const savedEditionId = String(savedEditionKey || '').match(/OL\d+M/i)?.[0];
        const coverImage = matchedSavedBook?.editionHeroImage
          || book.editionHeroImage
          || (savedEditionId
            ? `https://covers.openlibrary.org/b/olid/${savedEditionId}-M.jpg?default=false`
            : null)
          || book.heroImage;
        const editionUrl = matchedSavedBook?.editionUrl
          || book.editionUrl
          || (savedEditionId ? `https://openlibrary.org/books/${savedEditionId}` : '');
        const workUrl = book.workKey
          ? `https://openlibrary.org/${String(book.workKey).replace(/^\/+/, '')}`
          : '';
        const recordUrl = editionUrl || workUrl;
        return `
        <div class="search-card">
          <div>
            ${coverImage
              ? `<img src="${coverImage}" alt="${book.title}" loading="${index === 0 ? 'eager' : 'lazy'}" decoding="async"${index === 0 ? ' fetchpriority="high"' : ''} />`
              : '<div class="search-cover-placeholder">NO IMAGE</div>'
            }
            <h5>${book.title}</h5>
            ${book.subtitle ? `<p class="subtitle">${book.subtitle}</p>` : ''}
            <p class="author-text">${authorLinksMarkup(book.author || 'Unknown Author')}</p>
            <p class="pub-date">${book.pubDate ? `Published: ${book.pubDate}` : 'Publication date unknown'}</p>
            <a class="selected-edition-link" href="${escapeHtml(recordUrl || '#')}" target="_blank" rel="noopener noreferrer" ${recordUrl ? '' : 'hidden'}>Open selected edition</a>
            ${book.workKey ? `<button type="button" class="edition-button" data-book-index="${index}" data-preferred-edition="${escapeHtml(String(savedEditionKey || ''))}">Browse editions${book.editionCount ? ` (${book.editionCount})` : ''}</button>` : ''}
          </div>
          <div class="shelf-control">
            <button type="button" class="shelf-primary">Want to Read</button>
            <button type="button" class="shelf-toggle" aria-label="Choose a reading list" aria-haspopup="menu" aria-expanded="false">▾</button>
            <div class="shelf-menu" role="menu" hidden>
              <button type="button" role="menuitem" data-status="Plan to Read">Want to Read</button>
              <button type="button" role="menuitem" data-status="Reading">Currently Reading</button>
              <button type="button" role="menuitem" data-status="Read">Read</button>
              <div class="shelf-menu-divider" role="separator"></div>
              <button type="button" role="menuitem" data-action="remove" hidden>Delete from My Lists</button>
            </div>
          </div>
        </div>
      `;
      }).join('');

      async function openEditionPicker(book: any, card: HTMLElement, button: HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Loading editions...';

        try {
          const params = new URLSearchParams({ work: book.workKey });
          const preferredEdition = button.dataset.preferredEdition || book.editionKey || '';
          if (preferredEdition) params.set('preferred_edition', preferredEdition);
          if (currentLanguage) params.set('language', currentLanguage);
          const response = await fetch(`/api/book-editions.json?${params}`);
          const data = await response.json();
          const editions = Array.isArray(data.editions) ? data.editions : [];
          const featuredCount = Math.min(
            editions.length,
            Number(data.featuredCount) || Math.min(10, editions.length),
          );
          const totalCount = Number(data.totalCount) || editions.length || book.editionCount || 0;
          book.editionCount = totalCount;
          button.textContent = `Browse editions${book.editionCount ? ` (${book.editionCount})` : ''}`;

          editionDialog.innerHTML = '';
          const header = document.createElement('div');
          header.className = 'edition-dialog-header';
          const heading = document.createElement('h3');
          heading.textContent = `Editions of ${book.title}`;
          const closeButton = document.createElement('button');
          closeButton.type = 'button';
          closeButton.className = 'edition-dialog-close';
          closeButton.textContent = 'Close';
          closeButton.addEventListener('click', () => editionDialog.close());
          header.append(heading, closeButton);
          editionDialog.appendChild(header);

          const summary = document.createElement('p');
          summary.className = 'edition-summary';
          summary.textContent = totalCount > featuredCount
            ? `Showing ${featuredCount} featured editions.`
            : `Showing all ${editions.length} editions.`;
          editionDialog.appendChild(summary);

          const list = document.createElement('div');
          list.className = 'edition-list';
          const pageSize = 12;
          let showingAllEditions = false;
          let currentEditionPage = 1;
          const pagination = document.createElement('div');
          pagination.className = 'edition-pagination';
          pagination.hidden = true;
          const previousPageButton = document.createElement('button');
          previousPageButton.type = 'button';
          previousPageButton.textContent = 'Previous';
          previousPageButton.setAttribute('aria-label', 'Previous editions page');
          const pageLabel = document.createElement('span');
          const nextPageButton = document.createElement('button');
          nextPageButton.type = 'button';
          nextPageButton.textContent = 'Next';
          nextPageButton.setAttribute('aria-label', 'Next editions page');
          pagination.append(previousPageButton, pageLabel, nextPageButton);

          const renderEditionOptions = () => {
            const pageCount = Math.max(1, Math.ceil(editions.length / pageSize));
            const visibleEditions = showingAllEditions
              ? editions.slice((currentEditionPage - 1) * pageSize, currentEditionPage * pageSize)
              : editions.slice(0, featuredCount);
            summary.textContent = showingAllEditions
              ? `Showing ${(currentEditionPage - 1) * pageSize + 1}–${Math.min(currentEditionPage * pageSize, editions.length)} of ${totalCount} editions.`
              : totalCount > featuredCount
                ? `Showing ${featuredCount} featured editions.`
                : `Showing all ${editions.length} editions.`;
            pagination.hidden = !showingAllEditions || pageCount <= 1;
            previousPageButton.disabled = currentEditionPage <= 1;
            nextPageButton.disabled = currentEditionPage >= pageCount;
            pageLabel.textContent = `Page ${currentEditionPage} of ${pageCount}`;
            list.innerHTML = '';
            if (visibleEditions.length === 0) {
              const emptyMessage = document.createElement('p');
              emptyMessage.textContent = 'No editions found.';
              list.appendChild(emptyMessage);
              return;
            }

            visibleEditions.forEach((edition: any) => {
              const option = document.createElement('button');
              option.type = 'button';
              option.className = 'edition-option';
              const image = document.createElement('img');
              image.alt = '';
              if (edition.coverImage) image.src = edition.coverImage;
              const details = document.createElement('span');
              const title = document.createElement('strong');
              title.textContent = edition.title;
              const metadata = document.createElement('span');
              metadata.textContent = [edition.language, edition.pubDate, edition.publisher]
                .filter(Boolean)
                .join(' · ');
              details.append(title, metadata);
              const chooseLabel = document.createElement('span');
              chooseLabel.className = 'edition-choice-label';
              const editionAlreadyAdded = getSavedBooks().some((savedBook: any) =>
                savedBook.editionKey && savedBook.editionKey === edition.key,
              ) || libraryBooks.some((savedBook: any) =>
                savedBook.editionKey && savedBook.editionKey === edition.key,
              );
              chooseLabel.textContent = editionAlreadyAdded ? '✓ Added' : 'Choose';
              option.append(image, details, chooseLabel);
              option.addEventListener('click', () => {
                book.key = edition.key;
                book.editionKey = edition.key;
                book.editionUrl = edition.url;
                book.editionHeroImage = edition.coverImage;
                book.editionLanguage = edition.language;
                book.title = edition.title;
                book.subtitle = edition.subtitle;
                book.pubDate = edition.pubDate;
                book.isbn = edition.isbn;
                book.heroImage = edition.coverImage;

                const cardImage = card.querySelector('img');
                if (cardImage && edition.coverImage) {
                  cardImage.src = edition.coverImage;
                  cardImage.alt = edition.title;
                } else if (edition.coverImage) {
                  const placeholder = card.querySelector('.search-cover-placeholder');
                  if (placeholder) {
                    const selectedImage = document.createElement('img');
                    selectedImage.src = edition.coverImage;
                    selectedImage.alt = edition.title;
                    placeholder.replaceWith(selectedImage);
                  }
                }
                const cardTitle = card.querySelector('h5');
                if (cardTitle) cardTitle.textContent = edition.title;
                const pubDate = card.querySelector('.pub-date');
                if (pubDate) pubDate.textContent = `Published: ${edition.pubDate}`;
                const selectedLink = card.querySelector<HTMLAnchorElement>('.selected-edition-link');
                if (selectedLink) {
                  selectedLink.href = edition.url;
                  selectedLink.hidden = false;
                }
                button.textContent = `Change edition${book.editionCount ? ` (${book.editionCount})` : ''}`;
                editionDialog.close();
              });
              list.appendChild(option);
            });

            if (editions.length > featuredCount) {
              const viewAllButton = document.createElement('button');
              viewAllButton.type = 'button';
              viewAllButton.className = 'edition-view-all';
              viewAllButton.textContent = `View all ${totalCount} editions`;
              viewAllButton.addEventListener('click', () => {
                showingAllEditions = true;
                currentEditionPage = 1;
                renderEditionOptions();
                list.scrollTop = 0;
              });
              list.appendChild(viewAllButton);
            }
          };
          previousPageButton.addEventListener('click', () => {
            if (currentEditionPage <= 1) return;
            currentEditionPage--;
            renderEditionOptions();
            list.scrollTop = 0;
          });
          nextPageButton.addEventListener('click', () => {
            if (currentEditionPage >= Math.ceil(editions.length / pageSize)) return;
            currentEditionPage++;
            renderEditionOptions();
            list.scrollTop = 0;
          });
          renderEditionOptions();

          editionDialog.appendChild(list);
          editionDialog.appendChild(pagination);
          editionDialog.showModal();
        } catch {
          editionDialog.innerHTML = '<p>Unable to load editions.</p>';
          editionDialog.showModal();
        } finally {
          button.disabled = false;
          if (button.textContent === 'Loading editions...') button.textContent = 'Browse editions';
        }
      }

      resultsContainer.querySelectorAll<HTMLButtonElement>('.edition-button').forEach((button) => {
        const book = displayBooks[Number(button.dataset.bookIndex)];
        const card = button.closest<HTMLElement>('.search-card');
        if (book && card) {
          button.addEventListener('click', () => openEditionPicker(book, card, button));
        }
      });

      resultsContainer.querySelectorAll<HTMLElement>('.shelf-control').forEach((control, index) => {
        const book = displayBooks[index];
        const primaryButton = control.querySelector<HTMLButtonElement>('.shelf-primary')!;
        const toggleButton = control.querySelector<HTMLButtonElement>('.shelf-toggle')!;
        const menu = control.querySelector<HTMLElement>('.shelf-menu')!;
        const removeButton = control.querySelector<HTMLButtonElement>('[data-action="remove"]')!;
        const savedBook = savedBooks.find((item: any) => isSameBook(item, book));
        const collectionBook = libraryBooks.find((item: any) =>
          shelfLabels[item.status] && isSameBook(item, book)
        );
        let currentStatus = savedBook?.status || collectionBook?.status || null;
        let hasSavedShelf = Boolean(savedBook || collectionBook);
        let hasLocalSavedBook = Boolean(savedBook);

        function updateShelfControl(status: string) {
          const label = shelfLabels[status] || shelfLabels['Plan to Read'];
          primaryButton.textContent = `${hasSavedShelf ? '✓ ' : ''}${label}`;
          removeButton.hidden = !hasLocalSavedBook;
          menu.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((option) => {
            if (option.dataset.status === status) {
              option.setAttribute('aria-current', 'true');
            } else {
              option.removeAttribute('aria-current');
            }
          });
        }

        updateShelfControl(currentStatus || 'Plan to Read');

        primaryButton.addEventListener('click', () => {
          const updatedBook = saveBookToShelf(book, currentStatus || 'Plan to Read');
          currentStatus = updatedBook.status;
          hasSavedShelf = true;
          hasLocalSavedBook = true;
          updateShelfControl(updatedBook.status);
        });

        toggleButton.addEventListener('click', (event) => {
          event.stopPropagation();
          const shouldOpen = menu.hidden;
          closeShelfMenus();
          menu.hidden = !shouldOpen;
          toggleButton.setAttribute('aria-expanded', String(shouldOpen));
        });

        menu.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((option) => {
          option.addEventListener('click', () => {
            const updatedBook = saveBookToShelf(book, option.dataset.status || 'Plan to Read');
            currentStatus = updatedBook.status;
            hasSavedShelf = true;
            hasLocalSavedBook = true;
            updateShelfControl(updatedBook.status);
            menu.hidden = true;
            toggleButton.setAttribute('aria-expanded', 'false');
          });
        });

        removeButton.addEventListener('click', () => {
          if (!hasLocalSavedBook) return;
          if (!window.confirm(`Delete "${book.title}" from your reading lists?`)) return;

          const updatedBooks = getSavedBooks().filter((item: any) => !isSameBook(item, book));
          localStorage.setItem(savedBooksKey, JSON.stringify(updatedBooks));
          currentStatus = collectionBook?.status || null;
          hasSavedShelf = Boolean(collectionBook);
          hasLocalSavedBook = false;
          updateShelfControl('Plan to Read');
          menu.hidden = true;
          toggleButton.setAttribute('aria-expanded', 'false');
          window.dispatchEvent(new CustomEvent('library:book-removed', { detail: book }));
        });
      });

      if (totalPages > 1) {
        paginationContainer.innerHTML = `
          <button id="prev-page" ${page <= 1 ? 'disabled' : ''}>← Previous</button>
          <span>Page ${page} of ${totalPages}</span>
          <button id="next-page" ${page >= totalPages ? 'disabled' : ''}>Next →</button>
        `;

        document.getElementById('prev-page')?.addEventListener('click', () => {
          if (currentPage > 1) performSearch(currentQuery, currentPage - 1, currentAuthorOnly, currentAuthorKey, currentAuthorExact, currentSort, currentLanguage);
        });

        document.getElementById('next-page')?.addEventListener('click', () => {
          if (currentPage < totalPages) performSearch(currentQuery, currentPage + 1, currentAuthorOnly, currentAuthorKey, currentAuthorExact, currentSort, currentLanguage);
        });
      }
    } catch (err) {
      resultsContainer.innerHTML = '<p>An error occurred while fetching books.</p>';
    }
  }

  window.addEventListener('book-library:author-search', (event) => {
    const detail = (event as CustomEvent<{
      query?: string;
      authorOnly?: boolean;
      authorKey?: string;
      authorExact?: boolean;
    }>).detail;
    const query = detail?.query?.trim();
    if (!query) return;

    searchInput.value = query;
    updateSearchClearButton();
    updateSearchResetButton();
    performSearch(
      query,
      1,
      detail?.authorOnly === true,
      detail?.authorKey || '',
      detail?.authorExact === true,
    );
  });

  const initialParams = new URLSearchParams(window.location.search);
  const initialQuery = initialParams.get('query')?.trim();
  if (initialQuery) {
    searchInput.value = initialQuery;
    updateSearchClearButton();
    updateSearchResetButton();
    performSearch(
      initialQuery,
      1,
      initialParams.get('author') === '1',
      initialParams.get('author_key') || '',
      initialParams.get('author_exact') === '1',
      initialParams.get('sort') || currentSort,
      initialParams.get('language') || '',
    );
  }

  searchInput?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    updateSearchClearButton();
    updateSearchResetButton();
    const query = searchInput.value.trim();

    if (query.length < 3) {
      currentQuery = '';
      currentPage = 1;
      currentAuthorOnly = false;
      currentAuthorKey = '';
      currentAuthorExact = false;
      currentLanguage = '';
      searchRequestId++;
      resultsContainer.innerHTML = '';
      summaryContainer.innerHTML = '';
      paginationContainer.innerHTML = '';
      searchLanguageSelect.innerHTML = '<option value="">Languages found after searching</option>';
      searchLanguageSelect.disabled = true;
      currentLanguage = '';
      return;
    }

    debounceTimer = setTimeout(() => {
      performSearch(query, 1, false, '', false, currentSort, '');
    }, 400);
  });

  clearSearchButton?.addEventListener('click', () => {
    searchInput.value = '';
    searchInput.dispatchEvent(new Event('input', { bubbles: true }));
    searchInput.focus();
  });

  resetSearchFiltersButton?.addEventListener('click', () => {
    clearTimeout(debounceTimer);
    searchInput.value = '';
    searchSortSelect.value = 'title-asc';
    searchLanguageSelect.value = '';
    currentSort = 'title-asc';
    currentLanguage = '';
    searchInput.dispatchEvent(new Event('input', { bubbles: true }));
    updateSearchResetButton();
    searchInput.focus();
  });

  searchSortSelect?.addEventListener('change', () => {
    updateSearchResetButton();
    if (currentQuery) {
      performSearch(
        currentQuery,
        1,
        currentAuthorOnly,
        currentAuthorKey,
        currentAuthorExact,
        searchSortSelect.value,
        currentLanguage,
      );
    }
  });

  searchLanguageSelect?.addEventListener('change', () => {
    currentLanguage = searchLanguageSelect.value;
    updateSearchResetButton();
    if (currentQuery) {
      performSearch(
        currentQuery,
        1,
        currentAuthorOnly,
        currentAuthorKey,
        currentAuthorExact,
        currentSort,
        currentLanguage,
      );
    }
  });

  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.shelf-control')) closeShelfMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeShelfMenus();
  });

</script>